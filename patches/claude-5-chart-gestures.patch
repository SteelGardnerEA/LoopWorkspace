@@ -0,0 +1,444 @@
+//
+//  ChartGestures.swift
+//  LoopKitUI
+//
+//  Display only. Trio-style gestures for a stack of time-aligned charts:
+//  drag pans through time (with glide after a flick), pinch zooms between
+//  1 and 24 hours, and double-tap is reported to the owner.
+//
+//  Like Trio, each chart is drawn once over a wider time range than is
+//  visible. While a finger is down the drawn charts are only slid or
+//  stretched, which keeps gestures smooth. When the gesture ends, the
+//  new time window is committed and the charts are redrawn.
+//
+
+import Foundation
+import QuartzCore
+import UIKit
+
+/// Where the drawn chart sits relative to the visible area.
+public struct ChartViewport: Equatable {
+    /// Drawn time span divided by visible time span (1 or more).
+    public var renderWidthScale: CGFloat
+    /// Where the visible start sits within the drawn time span, from 0 to 1.
+    public var leadingFraction: CGFloat
+    /// Horizontal space the chart uses outside its plot area.
+    public var fixedHorizontalMargin: CGFloat
+    /// Width of the y-axis label area on the chart's left.
+    public var labelAreaWidth: CGFloat
+
+    public init(renderWidthScale: CGFloat, leadingFraction: CGFloat, fixedHorizontalMargin: CGFloat, labelAreaWidth: CGFloat) {
+        self.renderWidthScale = renderWidthScale
+        self.leadingFraction = leadingFraction
+        self.fixedHorizontalMargin = fixedHorizontalMargin
+        self.labelAreaWidth = labelAreaWidth
+    }
+}
+
+/// The time range shown by the charts.
+public struct ChartTimeWindow: Equatable {
+    public static let minimumDuration: TimeInterval = .hours(1)
+    public static let maximumDuration: TimeInterval = .hours(24)
+    /// Loop keeps 7 days of history.
+    public static let historyLimit: TimeInterval = .hours(24 * 7)
+
+    /// Visible time span.
+    public var duration: TimeInterval
+    /// Share of the window after now when following now (the forecast area).
+    public var futureFraction: Double
+    /// Start of the window when the user has moved back in time. Nil means it follows now.
+    public var pinnedStart: Date?
+
+    public init(duration: TimeInterval, futureFraction: Double, pinnedStart: Date? = nil) {
+        self.duration = min(max(duration, Self.minimumDuration), Self.maximumDuration)
+        self.futureFraction = min(max(futureFraction, 0), 0.9)
+        self.pinnedStart = pinnedStart
+    }
+
+    public var isLive: Bool {
+        return pinnedStart == nil
+    }
+
+    public func liveStart(now: Date) -> Date {
+        return now.addingTimeInterval(-duration * (1 - futureFraction))
+    }
+
+    public func start(now: Date) -> Date {
+        return pinnedStart ?? liveStart(now: now)
+    }
+
+    public func end(now: Date) -> Date {
+        return start(now: now).addingTimeInterval(duration)
+    }
+
+    public func oldestStart(now: Date) -> Date {
+        return now.addingTimeInterval(-Self.historyLimit)
+    }
+
+    /// Spacing of the time labels, wider when zoomed out so they don't overlap.
+    public var axisStep: TimeInterval {
+        if duration <= .hours(8) {
+            return .hours(1)
+        } else if duration <= .hours(14) {
+            return .hours(2)
+        } else if duration <= .hours(20) {
+            return .hours(3)
+        } else {
+            return .hours(4)
+        }
+    }
+
+    /// The range to draw: the visible window plus room on each side to slide into,
+    /// aligned to the time label spacing so the time axis matches it exactly.
+    public func renderRange(now: Date) -> DateInterval {
+        let buffer = min(duration * 2, .hours(24))
+        let visibleStart = start(now: now)
+        let visibleEnd = end(now: now)
+        let latestEnd = max(visibleEnd, liveStart(now: now).addingTimeInterval(duration))
+
+        let rawStart = max(visibleStart.addingTimeInterval(-buffer), oldestStart(now: now))
+        let rawEnd = max(min(visibleEnd.addingTimeInterval(buffer), latestEnd), visibleEnd)
+
+        let step = axisStep
+        let alignedStart = (rawStart.timeIntervalSince1970 / step).rounded(.down) * step
+        let alignedEnd = (rawEnd.timeIntervalSince1970 / step).rounded(.up) * step
+        return DateInterval(
+            start: Date(timeIntervalSince1970: min(alignedStart, visibleStart.timeIntervalSince1970)),
+            end: Date(timeIntervalSince1970: max(alignedEnd, visibleEnd.timeIntervalSince1970))
+        )
+    }
+
+    public func viewport(now: Date, fixedHorizontalMargin: CGFloat, labelAreaWidth: CGFloat) -> ChartViewport {
+        let range = renderRange(now: now)
+        return ChartViewport(
+            renderWidthScale: CGFloat(range.duration / duration),
+            leadingFraction: CGFloat(start(now: now).timeIntervalSince(range.start) / range.duration),
+            fixedHorizontalMargin: fixedHorizontalMargin,
+            labelAreaWidth: labelAreaWidth
+        )
+    }
+
+    /// The same window moved to start at `newStart`. Snaps back to following now
+    /// when it reaches the present, and never goes past the oldest saved history.
+    public func withStart(_ newStart: Date, now: Date) -> ChartTimeWindow {
+        var window = self
+        if newStart >= liveStart(now: now).addingTimeInterval(-.minutes(1)) {
+            window.pinnedStart = nil
+        } else {
+            window.pinnedStart = max(newStart, oldestStart(now: now))
+        }
+        return window
+    }
+
+    /// Dragging right by `points` moves back in time.
+    public func panned(byPoints points: CGFloat, plotWidth: CGFloat, now: Date) -> ChartTimeWindow {
+        guard plotWidth > 0 else {
+            return self
+        }
+        let seconds = TimeInterval(points) * duration / TimeInterval(plotWidth)
+        return withStart(start(now: now).addingTimeInterval(-seconds), now: now)
+    }
+
+    /// Zooms to a new duration, keeping the time under `anchorFraction` (0 is the left
+    /// edge, 1 the right) in place. While following now it keeps following now.
+    public func zoomed(toDuration rawDuration: TimeInterval, anchorFraction: Double, now: Date) -> ChartTimeWindow {
+        let newDuration = min(max(rawDuration, Self.minimumDuration), Self.maximumDuration)
+        let anchorDate = start(now: now).addingTimeInterval(duration * anchorFraction)
+        var window = self
+        window.duration = newDuration
+        guard !isLive else {
+            return window
+        }
+        return window.withStart(anchorDate.addingTimeInterval(-newDuration * anchorFraction), now: now)
+    }
+}
+
+/// Runs drag, pinch, and double-tap on a table of chart cells.
+public final class ChartGestureController: NSObject, UIGestureRecognizerDelegate {
+
+    /// The committed time window the charts are drawn for.
+    public var window: ChartTimeWindow
+
+    /// The chart containers currently on screen.
+    public var chartContainers: () -> [ChartContainerView] = { [] }
+
+    /// Whether a point (in the table's coordinates) is over a chart.
+    public var isChartLocation: (CGPoint) -> Bool = { _ in false }
+
+    /// Width of the visible plot area.
+    public var plotWidth: () -> CGFloat = { 0 }
+
+    /// The press-and-hold inspect recognizer. Panning never starts while it is active.
+    public weak var inspectRecognizer: UIGestureRecognizer?
+
+    /// Called with the new window when a drag, flick, or pinch finishes.
+    public var onCommit: ((ChartTimeWindow) -> Void)?
+
+    /// Called with the location (in the table's coordinates) of a double-tap on a chart.
+    public var onDoubleTap: ((CGPoint) -> Void)?
+
+    /// Called after every drag, flick, or pinch ends, whether or not the window changed.
+    public var onSettle: (() -> Void)?
+
+    public var now: () -> Date = { Date() }
+
+    private weak var tableView: UITableView?
+    private let panRecognizer = UIPanGestureRecognizer()
+    private let pinchRecognizer = UIPinchGestureRecognizer()
+    private let doubleTapRecognizer = UITapGestureRecognizer()
+
+    // Live gesture state, in points of the visible plot.
+    private var translation: CGFloat = 0
+    private var scale: CGFloat = 1
+    private var anchorX: CGFloat = 0
+    private var displayLink: CADisplayLink?
+    private var velocity: CGFloat = 0
+    private var lastFrameTime: CFTimeInterval = 0
+
+    public init(window: ChartTimeWindow) {
+        self.window = window
+        super.init()
+    }
+
+    deinit {
+        displayLink?.invalidate()
+    }
+
+    public func install(on tableView: UITableView) {
+        self.tableView = tableView
+
+        panRecognizer.addTarget(self, action: #selector(handlePan(_:)))
+        panRecognizer.delegate = self
+        panRecognizer.maximumNumberOfTouches = 1
+        tableView.addGestureRecognizer(panRecognizer)
+        // Vertical scrolling waits for a horizontal chart drag to be ruled out.
+        tableView.panGestureRecognizer.require(toFail: panRecognizer)
+
+        pinchRecognizer.addTarget(self, action: #selector(handlePinch(_:)))
+        pinchRecognizer.delegate = self
+        tableView.addGestureRecognizer(pinchRecognizer)
+
+        doubleTapRecognizer.addTarget(self, action: #selector(handleDoubleTap(_:)))
+        doubleTapRecognizer.numberOfTapsRequired = 2
+        doubleTapRecognizer.cancelsTouchesInView = false
+        doubleTapRecognizer.delegate = self
+        tableView.addGestureRecognizer(doubleTapRecognizer)
+    }
+
+    /// True while a finger is moving the charts or they are still gliding.
+    public var isInteracting: Bool {
+        return displayLink != nil
+            || panRecognizer.state == .began || panRecognizer.state == .changed
+            || pinchRecognizer.state == .began || pinchRecognizer.state == .changed
+    }
+
+    /// Stops any glide and puts the charts back where they were drawn.
+    public func cancel() {
+        stopGlide()
+        translation = 0
+        scale = 1
+        applyTransforms()
+    }
+
+    // MARK: - UIGestureRecognizerDelegate
+
+    public func gestureRecognizer(_ gestureRecognizer: UIGestureRecognizer, shouldReceive touch: UITouch) -> Bool {
+        guard let tableView = tableView else {
+            return false
+        }
+        return isChartLocation(touch.location(in: tableView))
+    }
+
+    public func gestureRecognizerShouldBegin(_ gestureRecognizer: UIGestureRecognizer) -> Bool {
+        guard let tableView = tableView, isChartLocation(gestureRecognizer.location(in: tableView)) else {
+            return false
+        }
+        if gestureRecognizer === panRecognizer {
+            if let inspect = inspectRecognizer, inspect.state == .began || inspect.state == .changed {
+                return false
+            }
+            // Only clearly sideways drags; up and down still scrolls the screen.
+            let velocity = panRecognizer.velocity(in: tableView)
+            return abs(velocity.x) > abs(velocity.y) * 1.2
+        }
+        return true
+    }
+
+    public func gestureRecognizer(_ gestureRecognizer: UIGestureRecognizer, shouldRecognizeSimultaneouslyWith otherGestureRecognizer: UIGestureRecognizer) -> Bool {
+        // Double-tap can run alongside anything; pan and pinch are exclusive of each other.
+        return gestureRecognizer === doubleTapRecognizer || otherGestureRecognizer === doubleTapRecognizer
+    }
+
+    // MARK: - Pan
+
+    @objc private func handlePan(_ recognizer: UIPanGestureRecognizer) {
+        guard let tableView = tableView else {
+            return
+        }
+        switch recognizer.state {
+        case .began:
+            stopGlide()
+            scale = 1
+            translation = clampedTranslation(recognizer.translation(in: tableView).x)
+            applyTransforms()
+        case .changed:
+            translation = clampedTranslation(recognizer.translation(in: tableView).x)
+            applyTransforms()
+        case .ended:
+            translation = clampedTranslation(recognizer.translation(in: tableView).x)
+            applyTransforms()
+            let flick = recognizer.velocity(in: tableView).x
+            if abs(flick) > 250 {
+                startGlide(velocity: flick)
+            } else {
+                commit()
+            }
+        case .cancelled, .failed:
+            commit()
+        default:
+            break
+        }
+    }
+
+    /// Limits a drag to what is drawn, to now on the right, and to 7 days back on the left.
+    private func clampedTranslation(_ proposed: CGFloat) -> CGFloat {
+        let width = plotWidth()
+        guard width > 0 else {
+            return 0
+        }
+        let date = now()
+        let secondsPerPoint = window.duration / TimeInterval(width)
+        let range = window.renderRange(now: date)
+        let visibleStart = window.start(now: date)
+        let visibleEnd = window.end(now: date)
+
+        // Positive moves back in time.
+        let backLimit = min(
+            visibleStart.timeIntervalSince(range.start),
+            visibleStart.timeIntervalSince(window.oldestStart(now: date))
+        )
+        let forwardLimit = min(
+            range.end.timeIntervalSince(visibleEnd),
+            window.liveStart(now: date).timeIntervalSince(visibleStart)
+        )
+        let maximum = CGFloat(max(0, backLimit) / secondsPerPoint)
+        let minimum = -CGFloat(max(0, forwardLimit) / secondsPerPoint)
+        return min(max(proposed, minimum), maximum)
+    }
+
+    // MARK: - Glide
+
+    private func startGlide(velocity: CGFloat) {
+        stopGlide()
+        self.velocity = velocity
+        lastFrameTime = CACurrentMediaTime()
+        let link = CADisplayLink(target: self, selector: #selector(glideStep(_:)))
+        link.add(to: .main, forMode: .common)
+        displayLink = link
+    }
+
+    private func stopGlide() {
+        displayLink?.invalidate()
+        displayLink = nil
+    }
+
+    @objc private func glideStep(_ link: CADisplayLink) {
+        let time = CACurrentMediaTime()
+        let elapsed = CGFloat(min(time - lastFrameTime, 0.05))
+        lastFrameTime = time
+
+        let proposed = translation + velocity * elapsed
+        let clamped = clampedTranslation(proposed)
+        translation = clamped
+        applyTransforms()
+
+        // Slows smoothly; about the feel of a scroll view.
+        velocity *= pow(0.94, elapsed * 60)
+        if abs(velocity) < 40 || clamped != proposed {
+            stopGlide()
+            commit()
+        }
+    }
+
+    // MARK: - Pinch
+
+    @objc private func handlePinch(_ recognizer: UIPinchGestureRecognizer) {
+        guard let container = chartContainers().first else {
+            return
+        }
+        switch recognizer.state {
+        case .began:
+            stopGlide()
+            translation = 0
+            if window.isLive, let viewport = container.viewport {
+                // Following now: zoom around "now" so it stays put, matching what the commit does.
+                anchorX = viewport.labelAreaWidth + plotWidth() * CGFloat(1 - window.futureFraction)
+            } else {
+                anchorX = recognizer.location(in: container).x
+            }
+            scale = clampedScale(recognizer.scale)
+            applyTransforms()
+        case .changed:
+            scale = clampedScale(recognizer.scale)
+            applyTransforms()
+        case .ended, .cancelled, .failed:
+            commit()
+        default:
+            break
+        }
+    }
+
+    /// Keeps the zoom between 1 and 24 hours on screen.
+    private func clampedScale(_ proposed: CGFloat) -> CGFloat {
+        guard proposed > 0 else {
+            return 1
+        }
+        let newDuration = min(max(window.duration / TimeInterval(proposed), ChartTimeWindow.minimumDuration), ChartTimeWindow.maximumDuration)
+        return CGFloat(window.duration / newDuration)
+    }
+
+    // MARK: - Double-tap
+
+    @objc private func handleDoubleTap(_ recognizer: UITapGestureRecognizer) {
+        guard recognizer.state == .ended, let tableView = tableView else {
+            return
+        }
+        onDoubleTap?(recognizer.location(in: tableView))
+    }
+
+    // MARK: - Drawing and committing
+
+    private func applyTransforms() {
+        for container in chartContainers() {
+            container.applyGestureTransform(translationX: translation, scaleX: scale, anchorX: anchorX)
+        }
+    }
+
+    private func commit() {
+        let date = now()
+        var newWindow = window
+
+        if scale != 1, let container = chartContainers().first, let viewport = container.viewport {
+            let plot = plotWidth()
+            let fraction = plot > 0 ? Double((anchorX - viewport.labelAreaWidth) / plot) : 0.5
+            newWindow = window.zoomed(
+                toDuration: window.duration / TimeInterval(scale),
+                anchorFraction: min(max(fraction, 0), 1),
+                now: date
+            )
+        } else if translation != 0 {
+            newWindow = window.panned(byPoints: translation, plotWidth: plotWidth(), now: date)
+        }
+
+        translation = 0
+        scale = 1
+
+        if newWindow != window {
+            window = newWindow
+            onCommit?(newWindow)
+        }
+        // Whatever the owner did not redraw goes back to rest.
+        applyTransforms()
+        onSettle?()
+    }
+}
