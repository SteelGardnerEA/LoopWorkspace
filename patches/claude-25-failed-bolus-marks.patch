+/// Display only. Boluses the pump didn't deliver (manual and automatic), kept 7 days in the app's
+/// own folder so the insulin chart can mark them with a small ×. Nothing here is used for dosing.
+final class FailedBolusLog {
+    static let shared = FailedBolusLog()
+
+    private let queue = DispatchQueue(label: "com.loopkit.Loop.FailedBolusLog")
+    private var stored: [FailedBolusMark]
+    private let keepDuration: TimeInterval = .days(7)
+
+    private static var fileURL: URL? {
+        guard let base = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first else {
+            return nil
+        }
+        try? FileManager.default.createDirectory(at: base, withIntermediateDirectories: true)
+        return base.appendingPathComponent("FailedBoluses.json")
+    }
+
+    init() {
+        if let url = Self.fileURL, let data = try? Data(contentsOf: url),
+           let saved = try? JSONDecoder().decode([FailedBolusMark].self, from: data) {
+            stored = saved
+        } else {
+            stored = []
+        }
+    }
+
+    /// Notes a bolus that came back with an error. `uncertain` means the pump couldn't tell
+    /// whether it delivered.
+    func record(units: Double, uncertain: Bool, at date: Date = Date()) {
+        guard units > 0 else {
+            return
+        }
+        queue.sync {
+            let oldest = date.addingTimeInterval(-keepDuration)
+            stored = stored.filter { $0.date >= oldest } + [FailedBolusMark(date: date, units: units, uncertain: uncertain)]
+            if let url = Self.fileURL, let data = try? JSONEncoder().encode(stored) {
+                try? data.write(to: url, options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+            }
+        }
+    }
+
+    func marks() -> [FailedBolusMark] {
+        return queue.sync { stored }
+    }
+}
