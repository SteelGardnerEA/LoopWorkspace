@@ -62,6 +62,14 @@ final class SceneDelegate: UIResponder, UIWindowSceneDelegate, WindowProvider {
             }
         }
 
+        if let index = previewArguments.firstIndex(of: "-ClaudeCustomizationDetailPreview"), index + 1 < previewArguments.count,
+           let customization = Customization(rawValue: previewArguments[index + 1]) {
+            // One customization's page, with its example picture.
+            window?.rootViewController = UIHostingController(rootView: NavigationStack { CustomizationDetailView(customization: customization) })
+            window?.makeKeyAndVisible()
