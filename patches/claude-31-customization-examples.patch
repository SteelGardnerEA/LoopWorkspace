diff --git a/Loop/Loop/Views/SettingsView.swift b/Loop/Loop/Views/SettingsView.swift
index e37bdd2..06be724 100644
--- a/Loop/Loop/Views/SettingsView.swift
+++ b/Loop/Loop/Views/SettingsView.swift
@@ -801,6 +801,19 @@ struct CustomizationDetailView: View {
                     Label(customization.title, systemImage: customization.systemImage)
                 }
             }
+            if let example = UIImage(named: "Customization Example " + customization.rawValue) {
+                Section(header: Text("Example", comment: "Customization page: example picture header")) {
+                    Image(uiImage: example)
+                        .resizable()
+                        .scaledToFit()
+                        .clipShape(RoundedRectangle(cornerRadius: 8))
+                        .accessibilityLabel(Text(customization.summary))
+                }
+            } else if customization == .originalToolbarSize {
+                Section(header: Text("Example", comment: "Customization page: example picture header")) {
+                    ToolbarSizeExample()
+                }
+            }
             Section(header: Text("What it does", comment: "Customization page: explanation header")) {
                 ForEach(customization.details, id: \.self) { paragraph in
                     Text(paragraph)
@@ -814,6 +827,8 @@ struct CustomizationDetailView: View {
         }
         .insetGroupedListStyle()
         .navigationTitle(customization.title)
+        // Small title, so long names aren't cut off.
+        .navigationBarTitleDisplayMode(.inline)
         .onChange(of: isOn) { _, newValue in
             customization.isOn = newValue
         }
@@ -845,3 +860,39 @@ struct CustomizationDetailView: View {
         }
     }
 }
+
+
+/// A drawing of the bottom bar, narrow (Loop on iOS 27) and wide (this customization on).
+private struct ToolbarSizeExample: View {
+    private let symbols = ["fork.knife", "clock", "drop.fill", "figure.run", "gearshape.fill"]
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 10) {
+            bar(spacing: 8, caption: NSLocalizedString("Off: Loop on iOS 27", comment: "Toolbar size example: narrow bar caption"))
+            bar(spacing: 26, caption: NSLocalizedString("On: original size", comment: "Toolbar size example: wide bar caption"))
+        }
+        .padding(.vertical, 6)
+        .accessibilityElement(children: .combine)
+    }
+
+    private func bar(spacing: CGFloat, caption: String) -> some View {
+        VStack(alignment: .leading, spacing: 4) {
+            Text(caption)
+                .font(.caption)
+                .foregroundColor(.secondary)
+            HStack {
+                Spacer()
+                HStack(spacing: spacing) {
+                    ForEach(symbols, id: \.self) { symbol in
+                        Image(systemName: symbol)
+                            .foregroundColor(.accentColor)
+                    }
+                }
+                .padding(.horizontal, 16)
+                .padding(.vertical, 10)
+                .background(Capsule().fill(Color(.tertiarySystemFill)))
+                Spacer()
+            }
+        }
+    }
+}
