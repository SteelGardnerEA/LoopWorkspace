+        let scrolled = chartHistoryOffset > 1
+        header.nowButton.isHidden = !scrolled
+        if scrolled {
+            let formatter = DateIntervalFormatter()
+            formatter.dateStyle = .medium
+            formatter.timeStyle = .short
+            header.label.text = formatter.string(from: chartVisibleInterval.start, to: chartVisibleInterval.end)
+        } else {
+            header.label.text = NSLocalizedString("Swipe charts sideways to look back, up to 7 days", comment: "Hint above the home screen charts when they are showing the live window")
+        }
+        header.nowButton.removeTarget(nil, action: nil, for: .allEvents)
+        header.nowButton.addTarget(self, action: #selector(returnChartsToNow), for: .touchUpInside)
+    }
+
+    /// Writes the display log from Loop's current status. Does not change dosing.
+    private func sampleDisplayStatus() {
+        guard deviceManager != nil, automaticDosingStatus != nil else {
+            return
+        }
+
+        let pumpCritical = deviceManager.pumpStatusHighlight?.state == .critical
+        let cgmCritical = deviceManager.cgmStatusHighlight?.state == .critical
+        let glucoseStale = deviceManager.isGlucoseValueStale
+        let pumpDataStale = Date().timeIntervalSince(deviceManager.doseStore.lastAddedPumpData) > LoopCoreConstants.inputDataRecencyInterval
+        let closedLoopOn = automaticDosingStatus.automaticDosingEnabled
+
+        displayStatusLog.recordObservation(
+            closedLoopOn: closedLoopOn,
+            lastLoopCompleted: deviceManager.loopManager.lastLoopCompleted,
+            pumpOrCGMDown: pumpCritical || cgmCritical || glucoseStale || pumpDataStale
+        )
+    }
+}
+
+private extension DisplayChartStatus {
+    var bandKind: StatusBandKind {
+        switch self {
+        case .closedLoop:
+            return .closedLoop
+        case .openLoop:
+            return .openLoop
+        case .notCompleting:
+            return .notCompleting
+        }
+    }
+}
+
+/// Lets a sideways swipe move the charts without stealing vertical scrolling.
+private final class ChartHistoryPanDelegate: NSObject, UIGestureRecognizerDelegate {
+    weak var tableView: UITableView?
+
+    func gestureRecognizerShouldBegin(_ gestureRecognizer: UIGestureRecognizer) -> Bool {
+        guard let pan = gestureRecognizer as? UIPanGestureRecognizer, let tableView = tableView else {
+            return false
+        }
+        let velocity = pan.velocity(in: tableView)
+        guard abs(velocity.x) > abs(velocity.y) else {
+            return false
+        }
+        let point = pan.location(in: tableView)
+        guard let indexPath = tableView.indexPathForRow(at: point),
+              let cell = tableView.cellForRow(at: indexPath),
+              cell is ChartTableViewCell else {
+            return false
+        }
+        return true
+    }
+
+    func gestureRecognizer(_ gestureRecognizer: UIGestureRecognizer, shouldRecognizeSimultaneouslyWith otherGestureRecognizer: UIGestureRecognizer) -> Bool {
+        return false
+    }
+}
+
+private final class ChartHistoryHeaderView: UITableViewHeaderFooterView {
+    static let reuseIdentifier = "ChartHistoryHeaderView"
+
+    let label = UILabel()
+    let nowButton = UIButton(type: .system)
+
+    override init(reuseIdentifier: String?) {
+        super.init(reuseIdentifier: reuseIdentifier)
+
+        label.font = .preferredFont(forTextStyle: .footnote)
+        label.textColor = .secondaryLabel
+        label.adjustsFontSizeToFitWidth = true
+        label.minimumScaleFactor = 0.7
+        label.translatesAutoresizingMaskIntoConstraints = false
+        label.setContentCompressionResistancePriority(.defaultLow, for: .horizontal)
+
+        nowButton.setTitle(NSLocalizedString("Now", comment: "Button that returns the home screen charts to the current time"), for: .normal)
+        nowButton.titleLabel?.font = .preferredFont(forTextStyle: .footnote)
+        nowButton.translatesAutoresizingMaskIntoConstraints = false
+        nowButton.accessibilityHint = NSLocalizedString("Returns the charts to the current time", comment: "Accessibility hint for the chart Now button")
+
+        contentView.addSubview(label)
+        contentView.addSubview(nowButton)
+
+        NSLayoutConstraint.activate([
+            label.leadingAnchor.constraint(equalTo: contentView.layoutMarginsGuide.leadingAnchor),
+            label.centerYAnchor.constraint(equalTo: contentView.centerYAnchor),
+            nowButton.leadingAnchor.constraint(greaterThanOrEqualTo: label.trailingAnchor, constant: 8),
+            nowButton.trailingAnchor.constraint(equalTo: contentView.layoutMarginsGuide.trailingAnchor),
+            nowButton.centerYAnchor.constraint(equalTo: contentView.centerYAnchor),
+        ])
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
 }
 
