+    private func setupChartHistoryScrolling() {
+        let pan = UIPanGestureRecognizer(target: self, action: #selector(handleChartHistoryPan(_:)))
+        pan.maximumNumberOfTouches = 1
+        pan.cancelsTouchesInView = false
+        pan.delegate = chartHistoryPanDelegate
+        chartHistoryPanDelegate.tableView = tableView
+        tableView.addGestureRecognizer(pan)
+        // Vertical scrolling waits until this pan decides it is not a sideways chart swipe.
+        tableView.panGestureRecognizer.require(toFail: pan)
+
+        tableView.register(ChartHistoryHeaderView.self, forHeaderFooterViewReuseIdentifier: ChartHistoryHeaderView.reuseIdentifier)
+
+        displayStatusTimer = Timer.scheduledTimer(withTimeInterval: 60, repeats: true) { [weak self] _ in
+            self?.sampleDisplayStatus()
+        }
+
+        let notificationCenter = NotificationCenter.default
+        notificationObservers += [
+            notificationCenter.addObserver(forName: UIApplication.didBecomeActiveNotification, object: nil, queue: .main) { [weak self] _ in
+                self?.sampleDisplayStatus()
+            },
+            notificationCenter.addObserver(forName: UIApplication.willResignActiveNotification, object: nil, queue: .main) { [weak self] _ in
+                self?.sampleDisplayStatus()
+                self?.displayStatusLog.flush()
+            },
+        ]
+
+        sampleDisplayStatus()
+    }
+
+    @objc private func handleChartHistoryPan(_ pan: UIPanGestureRecognizer) {
+        switch pan.state {
+        case .changed:
+            let translation = pan.translation(in: tableView).x
+            pan.setTranslation(.zero, in: tableView)
+            guard LoopConstants.minimumChartWidthPerHour > 0 else {
+                return
+            }
+            // Drag toward the right to reveal earlier hours.
+            let hours = Double(translation / LoopConstants.minimumChartWidthPerHour)
+            chartHistoryOffset += .hours(hours)
+            scheduleChartHistoryReload()
+        case .ended, .cancelled, .failed:
+            scheduleChartHistoryReload()
+        default:
+            break
+        }
+    }
+
+    private func scheduleChartHistoryReload() {
+        updateChartHistoryHeader()
+        chartHistoryReloadWork?.cancel()
+        let work = DispatchWorkItem { [weak self] in
+            guard let self = self else {
+                return
+            }
+            self.refreshContext.formUnion(RefreshContext.all)
+            self.reloadData(animated: false)
+        }
+        chartHistoryReloadWork = work
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.3, execute: work)
+    }
+
+    @objc private func returnChartsToNow() {
+        chartHistoryOffset = 0
+        chartHistoryReloadWork?.cancel()
+        refreshContext.formUnion(RefreshContext.all)
+        updateChartHistoryHeader()
+        reloadData(animated: false)
+    }
+
+    private func updateChartHistoryHeader() {
+        guard let header = tableView.headerView(forSection: Section.charts.rawValue) as? ChartHistoryHeaderView else {
+            return
+        }
+        configureChartHistoryHeader(header)
+    }
+
+    private func configureChartHistoryHeader(_ header: ChartHistoryHeaderView) {
+        let scrolled = chartHistoryOffset > 1
+        header.nowButton.isHidden = !scrolled
+        if scrolled {
+            let formatter = DateIntervalFormatter()
+            formatter.dateStyle = .medium
+            formatter.timeStyle = .short
+            header.label.text = formatter.string(from: chartVisibleInterval.start, to: chartVisibleInterval.end)
+        } else {
+            header.label.text = NSLocalizedString("Swipe charts sideways to look back, up to 7 days", comment: "Hint above the home screen charts when they are showing the live window")
+        }
+        header.nowButton.removeTarget(nil, action: nil, for: .allEvents)
+        header.nowButton.addTarget(self, action: #selector(returnChartsToNow), for: .touchUpInside)
+    }
+
+    /// Writes the display log from Loop's current status. Does not change dosing.
+    private func sampleDisplayStatus() {
+        guard deviceManager != nil, automaticDosingStatus != nil else {
+            return
+        }
+
+        let pumpCritical = deviceManager.pumpStatusHighlight?.state == .critical
+        let cgmCritical = deviceManager.cgmStatusHighlight?.state == .critical
+        let glucoseStale = deviceManager.isGlucoseValueStale
+        let pumpDataStale = Date().timeIntervalSince(deviceManager.doseStore.lastAddedPumpData) > LoopCoreConstants.inputDataRecencyInterval
+        let closedLoopOn = automaticDosingStatus.automaticDosingEnabled
+
+        displayStatusLog.recordObservation(
+            closedLoopOn: closedLoopOn,
+            lastLoopCompleted: deviceManager.loopManager.lastLoopCompleted,
+            pumpOrCGMDown: pumpCritical || cgmCritical || glucoseStale || pumpDataStale
+        )
+    }
+}
