diff --git a/Loop/Loop/Managers/DisplayStatusLog.swift b/Loop/Loop/Managers/DisplayStatusLog.swift
new file mode 100644
index 0000000..c4d6788
--- /dev/null
+++ b/Loop/Loop/Managers/DisplayStatusLog.swift
@@ -0,0 +1,263 @@
+//
+//  DisplayStatusLog.swift
+//  Loop
+//
+//  Display-only log of home-screen chart status colors.
+//
+//  This file is not used for dosing. It writes its own JSON file under
+//  Application Support. Dose stores, the algorithm, and pump or CGM code do not read it.
+//
+
+import Foundation
+import LoopCore
+import os.log
+
+/// Colors the home-screen charts can show. Stored only for display.
+enum DisplayChartStatus: String, Codable, Equatable {
+    /// Closed loop on, loop still completing, pump and CGM still connected.
+    case closedLoop
+    /// Closed loop off, and Loop is still completing.
+    case openLoop
+    /// Loop not completing, pump or CGM disconnected, or a gap with no log.
+    case notCompleting
+}
+
+struct DisplayStatusSegment: Equatable {
+    var start: Date
+    var end: Date
+    var status: DisplayChartStatus
+}
+
+/// A small change-log of display status, kept for Loop's local cache length.
+///
+/// An entry is written when the status changes. While the app is open, the log
+/// also remembers the last moment status was actually looked at. Time after that
+/// moment, including while the app is closed or the phone is off, is treated as
+/// not completing (red) until the app looks again.
+final class DisplayStatusLog {
+
+    /// If we go longer than this without looking, the missing stretch is red.
+    /// A bit longer than the one-minute check, so a late timer is not a false gap.
+    static let unobservedGap: TimeInterval = 180
+
+    private struct Entry: Codable, Equatable {
+        var date: Date
+        var status: DisplayChartStatus
+    }
+
+    private struct Snapshot: Codable {
+        var entries: [Entry]
+        var lastObservedAt: Date?
+    }
+
+    private let log = OSLog(category: "DisplayStatusLog")
+    private let fileURL: URL
+    private let retention: TimeInterval
+    private let encoder: JSONEncoder = {
+        let encoder = JSONEncoder()
+        encoder.dateEncodingStrategy = .secondsSince1970
+        encoder.outputFormatting = [.sortedKeys]
+        return encoder
+    }()
+    private let decoder: JSONDecoder = {
+        let decoder = JSONDecoder()
+        decoder.dateDecodingStrategy = .secondsSince1970
+        return decoder
+    }()
+
+    private var entries: [Entry] = []
+    private var lastObservedAt: Date?
+    private var saveWork: DispatchWorkItem?
+
+    init(retention: TimeInterval = Bundle.main.localCacheDuration, fileURL: URL? = nil) {
+        self.retention = retention
+        if let fileURL = fileURL {
+            self.fileURL = fileURL
+        } else {
+            let directory = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first!
+                .appendingPathComponent("LoopDisplayStatus", isDirectory: true)
+            self.fileURL = directory.appendingPathComponent("DisplayStatusLog.json")
+        }
+        load()
+    }
+
+    /// Reads Loop's existing state and stores a display status. Does not change that state.
+    func recordObservation(closedLoopOn: Bool,
+                           lastLoopCompleted: Date?,
+                           pumpOrCGMDown: Bool,
+                           at date: Date = Date()) {
+        let loopNotCompleting = LoopCompletionFreshness(lastCompletion: lastLoopCompleted, at: date) == .stale
+        let status: DisplayChartStatus
+        if loopNotCompleting || pumpOrCGMDown {
+            status = .notCompleting
+        } else if !closedLoopOn {
+            status = .openLoop
+        } else {
+            status = .closedLoop
+        }
+        record(status, at: date)
+    }
+
+    func record(_ status: DisplayChartStatus, at date: Date) {
+        dispatchPrecondition(condition: .onQueue(.main))
+
+        var statusChanged = false
+        if let lastObservedAt = lastObservedAt, date.timeIntervalSince(lastObservedAt) > Self.unobservedGap {
+            statusChanged = appendChange(.notCompleting, at: lastObservedAt) || statusChanged
+        }
+        statusChanged = appendChange(status, at: date) || statusChanged
+        lastObservedAt = date
+        purge(keepingStatusAt: date.addingTimeInterval(-retention))
+        scheduleSave(immediate: statusChanged)
+    }
+
+    func flush() {
+        dispatchPrecondition(condition: .onQueue(.main))
+        saveWork?.cancel()
+        saveWork = nil
+        saveNow()
+    }
+
+    /// Status stretches covering `start`..<`end`. Unobserved gaps are not completing.
+    /// While the app is looking, the current color continues to the end of the chart,
+    /// including the usual future prediction area, so the live chart is fully tinted.
+    func segments(from start: Date, to end: Date, now: Date = Date()) -> [DisplayStatusSegment] {
+        guard end > start else {
+            return []
+        }
+
+        let sorted = entries.sorted { $0.date < $1.date }
+        let observingNow = lastObservedAt.map { now.timeIntervalSince($0) <= Self.unobservedGap } ?? false
+
+        var marks = [start, end]
+        for entry in sorted where entry.date > start && entry.date < end {
+            marks.append(entry.date)
+        }
+        if let lastObservedAt = lastObservedAt, lastObservedAt > start, lastObservedAt < end {
+            marks.append(lastObservedAt)
+        }
+        marks.sort()
+
+        var uniqueMarks: [Date] = []
+        for mark in marks where uniqueMarks.last != mark {
+            uniqueMarks.append(mark)
+        }
+
+        var result: [DisplayStatusSegment] = []
+        for index in 0..<(uniqueMarks.count - 1) {
+            let segmentStart = uniqueMarks[index]
+            let segmentEnd = uniqueMarks[index + 1]
+            guard segmentEnd > segmentStart else {
+                continue
+            }
+
+            let status: DisplayChartStatus
+            if let lastObservedAt = lastObservedAt, segmentStart >= lastObservedAt {
+                if observingNow {
+                    status = loggedStatus(at: lastObservedAt, entries: sorted)
+                } else {
+                    status = .notCompleting
+                }
+            } else {
+                status = loggedStatus(at: segmentStart, entries: sorted)
+            }
+
+            if let previous = result.last, previous.status == status, previous.end == segmentStart {
+                result[result.count - 1] = DisplayStatusSegment(start: previous.start, end: segmentEnd, status: status)
+            } else {
+                result.append(DisplayStatusSegment(start: segmentStart, end: segmentEnd, status: status))
+            }
+        }
+        return result
+    }
+
+    /// Returns true when the saved color actually changes.
+    @discardableResult
+    private func appendChange(_ status: DisplayChartStatus, at date: Date) -> Bool {
+        if let last = entries.last, last.status == status, last.date <= date {
+            return false
+        }
+        entries.append(Entry(date: date, status: status))
+        entries.sort { $0.date < $1.date }
+        collapseConsecutiveStatuses()
+        return true
+    }
+
+    private func loggedStatus(at date: Date, entries: [Entry]) -> DisplayChartStatus {
+        var current: DisplayChartStatus = .notCompleting
+        for entry in entries {
+            if entry.date <= date {
+                current = entry.status
+            } else {
+                break
+            }
+        }
+        return current
+    }
+
+    /// Keep one entry from before the cutoff so the color at the start of the window is known.
+    private func purge(keepingStatusAt cutoff: Date) {
+        let older = entries.filter { $0.date < cutoff }
+        let newer = entries.filter { $0.date >= cutoff }
+        if let keep = older.last {
+            entries = [keep] + newer
+        } else {
+            entries = newer
+        }
+        collapseConsecutiveStatuses()
+    }
+
+    private func collapseConsecutiveStatuses() {
+        var collapsed: [Entry] = []
+        for entry in entries where collapsed.last?.status != entry.status {
+            collapsed.append(entry)
+        }
+        entries = collapsed
+    }
+
+    private func scheduleSave(immediate: Bool) {
+        if immediate {
+            saveWork?.cancel()
+            saveWork = nil
+            saveNow()
+            return
+        }
+        guard saveWork == nil else {
+            return
+        }
+        let work = DispatchWorkItem { [weak self] in
+            self?.saveWork = nil
+            self?.saveNow()
+        }
+        saveWork = work
+        DispatchQueue.main.asyncAfter(deadline: .now() + 15, execute: work)
+    }
+
+    private func load() {
+        guard FileManager.default.fileExists(atPath: fileURL.path) else {
+            return
+        }
+        do {
+            let data = try Data(contentsOf: fileURL)
+            let snapshot = try decoder.decode(Snapshot.self, from: data)
+            entries = snapshot.entries.sorted { $0.date < $1.date }
+            lastObservedAt = snapshot.lastObservedAt
+        } catch {
+            log.error("Could not read display status log: %{public}@", String(describing: error))
+            entries = []
+            lastObservedAt = nil
+        }
+    }
+
+    private func saveNow() {
+        let snapshot = Snapshot(entries: entries, lastObservedAt: lastObservedAt)
+        do {
+            let directory = fileURL.deletingLastPathComponent()
+            try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+            let data = try encoder.encode(snapshot)
+            try data.write(to: fileURL, options: .atomic)
+        } catch {
+            log.error("Could not write display status log: %{public}@", String(describing: error))
+        }
+    }
+}
