diff --git a/Loop/Loop/View Controllers/StatusBandPreviewController.swift b/Loop/Loop/View Controllers/StatusBandPreviewController.swift
new file mode 100644
index 0000000..3c2c14c
--- /dev/null
+++ b/Loop/Loop/View Controllers/StatusBandPreviewController.swift	
@@ -0,0 +1,130 @@
+//
+//  StatusBandPreviewController.swift
+//  Loop
+//
+//  Display-only screen used by the simulator check.
+//  It is shown only when the app is launched with -LoopStatusBandPreview.
+//  The normal launch path does not use it, and it does not start dosing.
+//
+
+import HealthKit
+import LoopKit
+import LoopKitUI
+import UIKit
+
+/// Shows the real home-screen chart drawing with sample colors, for a simulator screenshot.
+final class StatusBandPreviewController: UIViewController {
+
+    private let chartsManager = StatusChartsManager(colors: .primary, settings: .default, traitCollection: .current)
+    private let header = UIView()
+    private let titleLabel = UILabel()
+    private let nowButton = UIButton(type: .system)
+    private var chartHosts: [UIView] = []
+    private var didRender = false
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        view.backgroundColor = .systemBackground
+
+        header.backgroundColor = .secondarySystemBackground
+        titleLabel.font = .preferredFont(forTextStyle: .footnote)
+        titleLabel.textColor = .secondaryLabel
+        titleLabel.adjustsFontSizeToFitWidth = true
+        titleLabel.minimumScaleFactor = 0.7
+        titleLabel.text = "Looking back · red, then blue stripes, then green"
+        nowButton.setTitle("Now", for: .normal)
+        nowButton.titleLabel?.font = .preferredFont(forTextStyle: .headline)
+        nowButton.accessibilityIdentifier = "Now"
+        header.addSubview(titleLabel)
+        header.addSubview(nowButton)
+        view.addSubview(header)
+
+        for name in ["Glucose", "Active Insulin", "Insulin Delivery", "Active Carbohydrates"] {
+            let host = UIView()
+            host.backgroundColor = .systemBackground
+            let label = UILabel()
+            label.text = name
+            label.font = .preferredFont(forTextStyle: .caption1)
+            label.textColor = .label
+            label.tag = 1
+            host.addSubview(label)
+            chartHosts.append(host)
+            view.addSubview(host)
+        }
+    }
+
+    override func viewDidLayoutSubviews() {
+        super.viewDidLayoutSubviews()
+
+        let headerHeight: CGFloat = 44
+        header.frame = CGRect(x: 0, y: view.safeAreaInsets.top, width: view.bounds.width, height: headerHeight)
+        nowButton.sizeToFit()
+        nowButton.frame.origin = CGPoint(x: header.bounds.width - nowButton.bounds.width - 16, y: (headerHeight - nowButton.bounds.height) / 2)
+        titleLabel.frame = CGRect(x: 16, y: 0, width: nowButton.frame.minX - 24, height: headerHeight)
+
+        let top = header.frame.maxY
+        let chartHeight = max(80, (view.bounds.height - top - view.safeAreaInsets.bottom) / CGFloat(chartHosts.count))
+        for (index, host) in chartHosts.enumerated() {
+            host.frame = CGRect(x: 0, y: top + CGFloat(index) * chartHeight, width: view.bounds.width, height: chartHeight)
+            if let label = host.viewWithTag(1) {
+                label.frame = CGRect(x: 12, y: 2, width: host.bounds.width - 24, height: 16)
+            }
+        }
+
+        guard !didRender, chartHosts.first?.bounds.height ?? 0 > 70 else {
+            return
+        }
+        didRender = true
+        renderCharts()
+    }
+
+    private func renderCharts() {
+        let now = Date()
+        let start = now.addingTimeInterval(.hours(-4))
+        let end = now.addingTimeInterval(.hours(2))
+        chartsManager.startDate = start
+        chartsManager.maxEndDate = end
+        chartsManager.updateEndDate(end)
+
+        let redEnd = start.addingTimeInterval(.hours(1.5))
+        let blueEnd = start.addingTimeInterval(.hours(3))
+        chartsManager.setStatusBands([
+            StatusBandSegment(start: start, end: redEnd, kind: .notCompleting),
+            StatusBandSegment(start: redEnd, end: blueEnd, kind: .openLoop),
+            StatusBandSegment(start: blueEnd, end: end, kind: .closedLoop),
+        ])
+
+        var glucose: [SimpleGlucoseValue] = []
+        var insulin: [InsulinValue] = []
+        var carbs: [CarbValue] = []
+        var cursor = start
+        var index = 0
+        while cursor <= now {
+            let mgdl = 150 + 25 * sin(Double(index) / 3)
+            glucose.append(SimpleGlucoseValue(startDate: cursor, quantity: HKQuantity(unit: .milligramsPerDeciliter, doubleValue: mgdl)))
+            insulin.append(InsulinValue(startDate: cursor, value: max(0, 1.2 + 0.4 * sin(Double(index) / 4))))
+            carbs.append(CarbValue(startDate: cursor, value: max(0, 12 + 8 * sin(Double(index) / 5))))
+            cursor = cursor.addingTimeInterval(.minutes(10))
+            index += 1
+        }
+        chartsManager.setGlucoseValues(glucose)
+        chartsManager.setIOBValues(insulin)
+        chartsManager.setCOBValues(carbs)
+        chartsManager.setDoseEntries([])
+        chartsManager.prerender()
+
+        let frames: [(CGRect) -> UIView?] = [
+            { self.chartsManager.glucoseChart(withFrame: $0)?.view },
+            { self.chartsManager.iobChart(withFrame: $0)?.view },
+            { self.chartsManager.doseChart(withFrame: $0)?.view },
+            { self.chartsManager.cobChart(withFrame: $0)?.view },
+        ]
+        for (index, host) in chartHosts.enumerated() {
+            let chartFrame = CGRect(x: 0, y: 18, width: host.bounds.width, height: host.bounds.height - 18)
+            if let chartView = frames[index](chartFrame) {
+                chartView.frame = chartFrame
+                host.addSubview(chartView)
+            }
+        }
+    }
+}
