+
+    /// The meal time picker's limits: the same as Loop's own carb screen (12 h back, 1 h ahead).
+    var mealTimeRange: ClosedRange<Date> {
+        let now = Date()
+        return now.addingTimeInterval(LoopConstants.maxCarbEntryPastTime)...now.addingTimeInterval(LoopConstants.maxCarbEntryFutureTime)
+    }
+
+    /// The meal time to use, kept inside the allowed range.
+    func mealStart(now: Date) -> Date {
+        guard let mealTime = mealTime else {
+            return now
+        }
+        let range = now.addingTimeInterval(LoopConstants.maxCarbEntryPastTime)...now.addingTimeInterval(LoopConstants.maxCarbEntryFutureTime)
+        return min(max(mealTime, range.lowerBound), range.upperBound)
+    }
