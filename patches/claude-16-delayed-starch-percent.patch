@@ -474,8 +476,22 @@ struct MealBreakdownFormula: Codable, Equatable {
 
     static let standard = MealBreakdownFormula()
 
-    var delayedStarchPercent: Double {
-        return 100 - mediumStarchPercent
+    init() {}
+
+    private enum CodingKeys: String, CodingKey {
+        case mediumStarchPercent, delayedStarchPercent, proteinPercent, proteinMinutesPerGram, fatMinutesPerGram
+    }
+
+    /// Reads a saved formula; anything missing (e.g. saved before a value existed) uses the standard number.
+    init(from decoder: Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+        let standard = MealBreakdownFormula.standard
+        mediumStarchPercent = try container.decodeIfPresent(Double.self, forKey: .mediumStarchPercent) ?? standard.mediumStarchPercent
+        // Saved before the delayed share had its own setting: keep it as "the rest".
+        delayedStarchPercent = try container.decodeIfPresent(Double.self, forKey: .delayedStarchPercent) ?? (100 - mediumStarchPercent)
+        proteinPercent = try container.decodeIfPresent(Double.self, forKey: .proteinPercent) ?? standard.proteinPercent
+        proteinMinutesPerGram = try container.decodeIfPresent(Double.self, forKey: .proteinMinutesPerGram) ?? standard.proteinMinutesPerGram
+        fatMinutesPerGram = try container.decodeIfPresent(Double.self, forKey: .fatMinutesPerGram) ?? standard.fatMinutesPerGram
     }
 
     private static let defaultsKey = "com.loopkit.Loop.MealBreakdownFormula"
@@ -500,6 +516,7 @@ struct MealBreakdownFormula: Codable, Equatable {
     var clamped: MealBreakdownFormula {
         var formula = self
         formula.mediumStarchPercent = min(max(mediumStarchPercent, 0), 100)
+        formula.delayedStarchPercent = min(max(delayedStarchPercent, 0), 100)
         formula.proteinPercent = min(max(proteinPercent, 0), 100)
         formula.proteinMinutesPerGram = min(max(proteinMinutesPerGram, 0), 30)
         formula.fatMinutesPerGram = min(max(fatMinutesPerGram, 0), 30)
