diff --git a/LoopKit/LoopKitUI/Charts/StatusBandChartLayer.swift b/LoopKit/LoopKitUI/Charts/StatusBandChartLayer.swift
new file mode 100644
index 0000000..8644f29
--- /dev/null
+++ b/LoopKit/LoopKitUI/Charts/StatusBandChartLayer.swift
@@ -0,0 +1,127 @@
+//
+//  StatusBandChartLayer.swift
+//  LoopKitUI
+//
+//  Display-only background tint for the home-screen charts.
+//  Nothing in this file is read by dosing.
+//
+
+import UIKit
+import SwiftCharts
+
+/// Which pale tint to paint behind a chart for a stretch of time.
+public enum StatusBandKind: Equatable {
+    /// Closed loop is on and Loop is still completing.
+    case closedLoop
+    /// Closed loop is off (open loop) and Loop is still completing.
+    case openLoop
+    /// Loop is not completing, a pump or CGM is disconnected, or there is no status log.
+    case notCompleting
+}
+
+/// One tinted stretch on the chart's time axis.
+public struct StatusBandSegment: Equatable {
+    public var start: Date
+    public var end: Date
+    public var kind: StatusBandKind
+
+    public init(start: Date, end: Date, kind: StatusBandKind) {
+        self.start = start
+        self.end = end
+        self.kind = kind
+    }
+}
+
+/// Paints status tints across the whole plot, behind glucose dots and the target band.
+public final class StatusBandChartLayer: ChartCoordsSpaceLayer {
+
+    private let segments: [StatusBandSegment]
+
+    public init?(xAxis: ChartAxis, yAxis: ChartAxis, segments: [StatusBandSegment]) {
+        let usable = segments.filter { $0.end > $0.start }
+        guard !usable.isEmpty else {
+            return nil
+        }
+        self.segments = usable
+        super.init(xAxis: xAxis, yAxis: yAxis)
+    }
+
+    public override func chartInitialized(chart: Chart) {
+        super.chartInitialized(chart: chart)
+
+        let view = StatusBandView(frame: chart.containerView.bounds)
+        view.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        view.isUserInteractionEnabled = false
+        view.isAccessibilityElement = false
+        view.backgroundColor = .clear
+        view.isOpaque = false
+        view.segments = segments.map { segment in
+            let startX = modelLocToScreenLoc(x: segment.start.timeIntervalSince1970)
+            let endX = modelLocToScreenLoc(x: segment.end.timeIntervalSince1970)
+            return StatusBandView.Segment(minX: min(startX, endX), maxX: max(startX, endX), kind: segment.kind)
+        }
+        // Chart init already placed the plot views. Insert behind them so dots stay crisp.
+        chart.containerView.insertSubview(view, at: 0)
+    }
+}
+
+private final class StatusBandView: UIView {
+
+    struct Segment {
+        var minX: CGFloat
+        var maxX: CGFloat
+        var kind: StatusBandKind
+    }
+
+    var segments: [Segment] = []
+
+    override func draw(_ rect: CGRect) {
+        guard let context = UIGraphicsGetCurrentContext() else {
+            return
+        }
+
+        for segment in segments {
+            let band = CGRect(x: segment.minX, y: bounds.minY, width: segment.maxX - segment.minX, height: bounds.height)
+            guard band.width > 0, band.intersects(rect) else {
+                continue
+            }
+
+            fillColor(for: segment.kind).setFill()
+            UIBezierPath(rect: band).fill()
+
+            // Open loop uses indigo stripes so it is not mistaken for the solid light-blue target band.
+            if segment.kind == .openLoop {
+                context.saveGState()
+                context.addRect(band)
+                context.clip()
+                stripeColor.setStroke()
+                let path = UIBezierPath()
+                path.lineWidth = 1
+                let spacing: CGFloat = 9
+                var x = band.minX - band.height
+                while x < band.maxX {
+                    path.move(to: CGPoint(x: x, y: band.maxY))
+                    path.addLine(to: CGPoint(x: x + band.height, y: band.minY))
+                    x += spacing
+                }
+                path.stroke()
+                context.restoreGState()
+            }
+        }
+    }
+
+    private func fillColor(for kind: StatusBandKind) -> UIColor {
+        switch kind {
+        case .closedLoop:
+            return UIColor.systemGreen.withAlphaComponent(0.16)
+        case .openLoop:
+            return UIColor.systemIndigo.withAlphaComponent(0.10)
+        case .notCompleting:
+            return UIColor.systemRed.withAlphaComponent(0.14)
+        }
+    }
+
+    private var stripeColor: UIColor {
+        UIColor.systemIndigo.withAlphaComponent(0.28)
+    }
+}
