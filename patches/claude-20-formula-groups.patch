+                    .font(.footnote.weight(.semibold))
+                    .foregroundColor(.secondary)
+                    .padding(.top, index > 0 ? 4 : 0)
+                MealBreakdownFormulaGroupRows(formula: $formula, group: group)
+            }
+        }
+    }
