+/// Steel's meal split. Display and carb entry only; Loop's dosing math is unchanged.
+///
+/// - Starches = carbs − sugars − fiber
+/// - Now 🍭: the sugars
+/// - Medium 🌮 (3 hours): 60% of starches
+/// - Delayed 🍕: 40% of starches + 50% of protein, absorbed from 3 hours after the meal
+///   until the delay, where delay = (protein × 4 min + fat × 8 min).
+///   If the delay is 3 hours or less there is no later window, so this part joins 🌮.
+struct MealBreakdown: Equatable {
+    var carbs: Double
+    var sugars: Double
+    var fiber: Double
+    var protein: Double
+    var fat: Double
+
+    static let delayedStart: TimeInterval = .hours(3)
+
+    var starches: Double {
+        return max(0, carbs - max(0, sugars) - max(0, fiber))
+    }
+
+    var fastGrams: Double {
+        return min(max(0, sugars), max(0, carbs))
+    }
+
+    var mediumGrams: Double {
+        return 0.6 * starches
+    }
+
+    var delayedGrams: Double {
+        return 0.4 * starches + 0.5 * max(0, protein)
+    }
+
+    var delay: TimeInterval {
+        return .minutes(max(0, protein) * 4 + max(0, fat) * 8)
+    }
+
+    var hasDelayedPart: Bool {
+        return delay > Self.delayedStart
+    }
+
+    var totalGrams: Double {
+        return fastGrams + mediumGrams + delayedGrams
+    }
+
+    struct Part: Equatable {
+        let emoji: String
+        let grams: Double
+        let start: Date
+        let absorptionTime: TimeInterval
+    }
+
+    /// The carb entries to save, in whole grams. Parts under 1 gram are left out.
+    func parts(now: Date, fastAbsorption: TimeInterval, mediumAbsorption: TimeInterval, minimumAbsorption: TimeInterval, maximumAbsorption: TimeInterval) -> [Part] {
+        var parts: [Part] = []
+
+        let fast = fastGrams.rounded()
+        if fast >= 1 {
+            parts.append(Part(emoji: "🍭", grams: fast, start: now, absorptionTime: fastAbsorption))
+        }
+
+        if hasDelayedPart {
+            let medium = mediumGrams.rounded()
+            if medium >= 1 {
+                parts.append(Part(emoji: "🌮", grams: medium, start: now, absorptionTime: mediumAbsorption))
+            }
+            let delayed = delayedGrams.rounded()
+            if delayed >= 1 {
+                let duration = min(max(delay - Self.delayedStart, minimumAbsorption), maximumAbsorption)
+                parts.append(Part(emoji: "🍕", grams: delayed, start: now.addingTimeInterval(Self.delayedStart), absorptionTime: duration))
+            }
+        } else {
+            let medium = (mediumGrams + delayedGrams).rounded()
+            if medium >= 1 {
+                parts.append(Part(emoji: "🌮", grams: medium, start: now, absorptionTime: mediumAbsorption))
+            }
+        }
+
+        return parts
+    }
+
+    /// "30 min", "3 h", or "4.7 h".
+    static func durationText(_ interval: TimeInterval) -> String {
+        let minutes = interval / 60
+        if minutes < 60 {
+            return String(format: NSLocalizedString("%d min", comment: "Duration in minutes (1: minutes)"), Int(minutes.rounded()))
+        }
+        let hours = interval / 3600
+        if abs(hours - hours.rounded()) < 0.05 {
+            return String(format: NSLocalizedString("%d h", comment: "Duration in whole hours (1: hours)"), Int(hours.rounded()))
+        }
+        return String(format: NSLocalizedString("%.1f h", comment: "Duration in hours with one decimal (1: hours)"), hours)
+    }
+}
