+// MARK: - Loop status background (display only)
+
+extension StatusTableViewController {
+    /// Works out when Loop was running, not running, or had automatic dosing turned off,
+    /// from Loop's saved cycle records and settings history. Reads only; changes nothing.
+    /// Calls `completion` on the main queue with nil if the history could not be read.
+    fileprivate func fetchLoopStatusPeriods(start: Date, completion: @escaping ([LoopStatusPeriod]?) -> Void) {
+        let dosingDecisionStore = deviceManager.dosingDecisionStore
+        let settingsStore = deviceManager.settingsManager.settingsStore
+        let lastLoopCompleted = deviceManager.loopManager.lastLoopCompleted
+        let currentDosingEnabled = deviceManager.loopManager.settings.dosingEnabled
+        let log = self.log
+
+        Task { @MainActor in
+            do {
+                let decisions = try await dosingDecisionStore.getDosingDecisions(start: start.addingTimeInterval(-LoopStatusTimeline.missedLoopThreshold))
+                var loopDates = decisions.filter { $0.reason == "loop" && $0.errors.isEmpty }.map { $0.date }
+                if let lastLoopCompleted = lastLoopCompleted {
+                    loopDates.append(lastLoopCompleted)
+                }
+
+                let storedSettings = (try? await settingsStore.getStoredSettings()) ?? []
+                let changes = storedSettings.map { AutomaticDosingChange(date: $0.date, enabled: $0.dosingEnabled) }
+
+                completion(LoopStatusTimeline.periods(
+                    successfulLoopDates: loopDates,
+                    automaticDosingChanges: changes,
+                    currentAutomaticDosingEnabled: currentDosingEnabled,
+                    start: start,
+                    now: Date()
+                ))
+            } catch {
+                log.error("Could not read loop history for the status background: %{public}@", String(describing: error))
+                completion(nil)
+            }
+        }
+    }
+}
