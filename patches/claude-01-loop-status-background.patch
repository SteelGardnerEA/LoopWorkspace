diff --git a/LoopKit/LoopKitUI/Charts/LoopStatusBackground.swift b/LoopKit/LoopKitUI/Charts/LoopStatusBackground.swift
new file mode 100644
index 0000000..9d79490
--- /dev/null
+++ b/LoopKit/LoopKitUI/Charts/LoopStatusBackground.swift
@@ -0,0 +1,274 @@
+//
+//  LoopStatusBackground.swift
+//  LoopKitUI
+//
+//  Display only. Shades the chart background to show when Loop was running,
+//  when it was not, and when automatic dosing was turned off.
+//  Nothing here reads or changes insulin dosing.
+//
+
+import Foundation
+import LoopKit
+import SwiftCharts
+import UIKit
+
+public enum LoopStatusKind: Equatable {
+    /// Loop completed a cycle recently.
+    case looping
+    /// No successful Loop cycle for longer than `LoopStatusTimeline.missedLoopThreshold`.
+    case notLooping
+    /// The user turned automatic dosing off.
+    case automaticDosingOff
+}
+
+public struct LoopStatusPeriod: Equatable {
+    public let start: Date
+    public let end: Date
+    public let kind: LoopStatusKind
+
+    public init(start: Date, end: Date, kind: LoopStatusKind) {
+        self.start = start
+        self.end = end
+        self.kind = kind
+    }
+}
+
+/// A saved value of the user's automatic dosing switch, effective from `date`.
+public struct AutomaticDosingChange: Equatable {
+    public let date: Date
+    public let enabled: Bool
+
+    public init(date: Date, enabled: Bool) {
+        self.date = date
+        self.enabled = enabled
+    }
+}
+
+public enum LoopStatusTimeline {
+    /// How long without a successful cycle before the background turns red.
+    /// Waiting this long keeps one missed reading from flashing red.
+    public static let missedLoopThreshold: TimeInterval = .minutes(15)
+
+    /// Normal time between Loop cycles.
+    public static let loopInterval: TimeInterval = .minutes(5)
+
+    /// Works out the background periods between `start` and `now`.
+    ///
+    /// - Parameters:
+    ///   - successfulLoopDates: Dates of Loop cycles that finished without an error, in any order.
+    ///   - automaticDosingChanges: Saved values of the automatic dosing switch, in any order.
+    ///     The value before the first saved change is assumed to match that change.
+    ///   - currentAutomaticDosingEnabled: Used for the whole range when no change was saved.
+    ///   - start: Earliest time to shade.
+    ///   - now: Latest time to shade.
+    /// - Returns: Periods sorted by time. Times before the first known Loop cycle are left unshaded.
+    public static func periods(
+        successfulLoopDates: [Date],
+        automaticDosingChanges: [AutomaticDosingChange],
+        currentAutomaticDosingEnabled: Bool,
+        start: Date,
+        now: Date
+    ) -> [LoopStatusPeriod] {
+        guard now > start else {
+            return []
+        }
+
+        let loopDates = Array(Set(successfulLoopDates.filter { $0 <= now })).sorted()
+        guard let lastLoopDate = loopDates.last else {
+            return []
+        }
+
+        var connection: [LoopStatusPeriod] = []
+
+        func add(_ periodStart: Date, _ periodEnd: Date, _ kind: LoopStatusKind) {
+            let clampedStart = max(periodStart, start)
+            let clampedEnd = min(periodEnd, now)
+            guard clampedEnd > clampedStart else {
+                return
+            }
+            connection.append(LoopStatusPeriod(start: clampedStart, end: clampedEnd, kind: kind))
+        }
+
+        // Between two cycles: a short gap still counts as looping. A long gap is
+        // looping for one normal cycle, then not looping until the next success.
+        func addInterval(from intervalStart: Date, to intervalEnd: Date) {
+            if intervalEnd.timeIntervalSince(intervalStart) <= missedLoopThreshold {
+                add(intervalStart, intervalEnd, .looping)
+            } else {
+                let lapse = intervalStart.addingTimeInterval(loopInterval)
+                add(intervalStart, lapse, .looping)
+                add(lapse, intervalEnd, .notLooping)
+            }
+        }
+
+        for (earlier, later) in zip(loopDates, loopDates.dropFirst()) {
+            addInterval(from: earlier, to: later)
+        }
+        addInterval(from: lastLoopDate, to: now)
+
+        let offIntervals = automaticDosingOffIntervals(
+            changes: automaticDosingChanges,
+            currentAutomaticDosingEnabled: currentAutomaticDosingEnabled,
+            start: start,
+            now: now
+        )
+
+        var result: [LoopStatusPeriod] = []
+        for period in merged(connection) {
+            var cursor = period.start
+            for off in offIntervals where off.end > period.start && off.start < period.end {
+                let offStart = max(off.start, period.start)
+                let offEnd = min(off.end, period.end)
+                if offStart > cursor {
+                    result.append(LoopStatusPeriod(start: cursor, end: offStart, kind: period.kind))
+                }
+                result.append(LoopStatusPeriod(start: offStart, end: offEnd, kind: .automaticDosingOff))
+                cursor = offEnd
+            }
+            if period.end > cursor {
+                result.append(LoopStatusPeriod(start: cursor, end: period.end, kind: period.kind))
+            }
+        }
+
+        return merged(result)
+    }
+
+    /// Sorted, non-overlapping ranges when automatic dosing was off, clipped to `start`...`now`.
+    static func automaticDosingOffIntervals(
+        changes: [AutomaticDosingChange],
+        currentAutomaticDosingEnabled: Bool,
+        start: Date,
+        now: Date
+    ) -> [DateInterval] {
+        let sortedChanges = changes.filter { $0.date <= now }.sorted { $0.date < $1.date }
+        let initiallyEnabled = sortedChanges.first?.enabled ?? currentAutomaticDosingEnabled
+
+        var intervals: [DateInterval] = []
+        var offSince: Date? = initiallyEnabled ? nil : .distantPast
+
+        for change in sortedChanges {
+            if change.enabled, let offStart = offSince {
+                intervals.append(DateInterval(start: offStart, end: change.date))
+                offSince = nil
+            } else if !change.enabled, offSince == nil {
+                offSince = change.date
+            }
+        }
+        if let offStart = offSince, now > offStart {
+            intervals.append(DateInterval(start: offStart, end: now))
+        }
+
+        return intervals.compactMap { interval in
+            let clampedStart = max(interval.start, start)
+            let clampedEnd = min(interval.end, now)
+            guard clampedEnd > clampedStart else {
+                return nil
+            }
+            return DateInterval(start: clampedStart, end: clampedEnd)
+        }
+    }
+
+    /// Joins touching periods of the same kind.
+    static func merged(_ periods: [LoopStatusPeriod]) -> [LoopStatusPeriod] {
+        var result: [LoopStatusPeriod] = []
+        for period in periods.sorted(by: { $0.start < $1.start }) {
+            if let last = result.last, last.kind == period.kind, last.end >= period.start {
+                result[result.count - 1] = LoopStatusPeriod(start: last.start, end: max(last.end, period.end), kind: last.kind)
+            } else {
+                result.append(period)
+            }
+        }
+        return result
+    }
+}
+
+extension LoopStatusKind {
+    /// Light tints so the background stays in the background.
+    var backgroundColor: UIColor {
+        switch self {
+        case .looping:
+            return UIColor.systemGreen.withAlphaComponent(0.12)
+        case .notLooping:
+            return UIColor.systemRed.withAlphaComponent(0.09)
+        case .automaticDosingOff:
+            return UIColor.systemGray.withAlphaComponent(0.16)
+        }
+    }
+}
+
+/// Draws the loop status periods as full-height bands behind the chart data.
+final class LoopStatusBackgroundLayer: ChartCoordsSpaceLayer {
+    private let periods: [LoopStatusPeriod]
+
+    init?(xAxis: ChartAxis, yAxis: ChartAxis, periods: [LoopStatusPeriod]) {
+        guard !periods.isEmpty else {
+            return nil
+        }
+        self.periods = periods
+        super.init(xAxis: xAxis, yAxis: yAxis)
+    }
+
+    override func chartInitialized(chart: Chart) {
+        super.chartInitialized(chart: chart)
+
+        // Coordinates are in the chart's inner container, which holds every data layer.
+        let top = modelLocToContainerScreenLoc(y: yAxis.last)
+        let bottom = modelLocToContainerScreenLoc(y: yAxis.first)
+        let minY = min(top, bottom)
+        let height = abs(bottom - top)
+        let axisStart = min(xAxis.first, xAxis.last)
+        let axisEnd = max(xAxis.first, xAxis.last)
+
+        let bands: [LoopStatusBackgroundView.Band] = periods.compactMap { period in
+            let startScalar = max(ChartAxisValueDate.scalarFromDate(period.start), axisStart)
+            let endScalar = min(ChartAxisValueDate.scalarFromDate(period.end), axisEnd)
+            guard endScalar > startScalar else {
+                return nil
+            }
+            let startX = modelLocToContainerScreenLoc(x: startScalar)
+            let endX = modelLocToContainerScreenLoc(x: endScalar)
+            return LoopStatusBackgroundView.Band(
+                rect: CGRect(x: min(startX, endX), y: minY, width: abs(endX - startX), height: height),
+                color: period.kind.backgroundColor
+            )
+        }
+
+        guard !bands.isEmpty else {
+            return
+        }
+
+        // Index 0 puts the bands under the lines, dots, areas, and target ranges.
+        let view = LoopStatusBackgroundView(frame: chart.containerView.bounds, bands: bands)
+        chart.containerView.insertSubview(view, at: 0)
+    }
+}
+
+final class LoopStatusBackgroundView: UIView {
+    struct Band {
+        let rect: CGRect
+        let color: UIColor
+    }
+
+    private let bands: [Band]
+
+    init(frame: CGRect, bands: [Band]) {
+        self.bands = bands
+        super.init(frame: frame)
+        backgroundColor = .clear
+        isUserInteractionEnabled = false
+    }
+
+    required init?(coder aDecoder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override func draw(_ rect: CGRect) {
+        guard let context = UIGraphicsGetCurrentContext() else {
+            return
+        }
+        for band in bands {
+            context.setFillColor(band.color.cgColor)
+            context.fill(band.rect)
+        }
+    }
+}
