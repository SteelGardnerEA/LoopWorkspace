+                chart.view.frame = CGRect(origin: CGPoint(x: area.minX, y: y), size: size)
+                view.addSubview(chart.view)
+                placedViews.append(chart.view)
+            }
+            y += row.1 + 10
+        }
+    }
+
+    private func loadSampleData() {
+        let now = Date()
+        let hourAgo6 = now.addingTimeInterval(.hours(-6))
+        let start = Calendar.current.nextDate(after: hourAgo6, matching: DateComponents(minute: 0), matchingPolicy: .strict, direction: .backward) ?? hourAgo6
+        charts.startDate = start
+        charts.maxEndDate = start.addingTimeInterval(.hours(9))
+        charts.updateEndDate(charts.maxEndDate)
+
+        let fiveMinutes = TimeInterval.minutes(5)
+        let pastTimes = stride(from: start.timeIntervalSince1970, through: now.timeIntervalSince1970, by: fiveMinutes).map { Date(timeIntervalSince1970: $0) }
+        let futureTimes = stride(from: now.timeIntervalSince1970, through: now.addingTimeInterval(.hours(3)).timeIntervalSince1970, by: fiveMinutes).map { Date(timeIntervalSince1970: $0) }
+
+        func wave(_ date: Date, period: TimeInterval) -> Double {
+            sin(date.timeIntervalSince1970 / period * 2 * .pi)
+        }
+
+        let glucose = pastTimes.map {
+            SimpleGlucoseValue(startDate: $0, quantity: HKQuantity(unit: .milligramsPerDeciliter, doubleValue: 130 + 45 * wave($0, period: .hours(4))))
+        }
+        charts.setGlucoseValues(glucose)
+        let lastGlucose = glucose.last?.quantity.doubleValue(for: .milligramsPerDeciliter) ?? 120
+        let predicted = futureTimes.enumerated().map { index, date in
+            SimpleGlucoseValue(startDate: date, quantity: HKQuantity(unit: .milligramsPerDeciliter, doubleValue: 110 + (lastGlucose - 110) * exp(-Double(index) / 12)))
+        }
+        charts.setPredictedGlucoseValues(predicted)
+
+        charts.setIOBValues((pastTimes + futureTimes).map { InsulinValue(startDate: $0, value: max(0, 1.4 + 1.1 * wave($0, period: .hours(5)))) })
+        charts.setCOBValues((pastTimes + futureTimes).map { CarbValue(startDate: $0, value: max(0, 18 * wave($0, period: .hours(7)))) })
+
+        let unitsPerHour = HKUnit.internationalUnit().unitDivided(by: .hour())
+        var doses: [DoseEntry] = []
+        for (index, date) in pastTimes.enumerated() where index % 6 == 0 {
+            doses.append(DoseEntry(type: .tempBasal, startDate: date, endDate: date.addingTimeInterval(.minutes(30)), value: max(0, 0.9 + 0.7 * wave(date, period: .hours(3))), unit: .unitsPerHour, scheduledBasalRate: HKQuantity(unit: unitsPerHour, doubleValue: 0.8)))
+        }
+        doses.append(DoseEntry(type: .bolus, startDate: now.addingTimeInterval(.hours(-4.5)), value: 3, unit: .units))
+        charts.setDoseEntries(doses)
+
+        // Made-up loop history: one missed reading 4 hours ago (stays green), a 50 minute
+        // outage about 2.5 hours ago (red), and automatic dosing off for 35 minutes (gray).
+        let outage = DateInterval(start: now.addingTimeInterval(.minutes(-180)), end: now.addingTimeInterval(.minutes(-130)))
+        let missedReading = now.addingTimeInterval(.minutes(-240))
+        let loopDates = pastTimes.filter { date in
+            !outage.contains(date) && abs(date.timeIntervalSince(missedReading)) > .minutes(2.5)
+        }
+        let changes = [
+            AutomaticDosingChange(date: now.addingTimeInterval(.hours(-8)), enabled: true),
+            AutomaticDosingChange(date: now.addingTimeInterval(.minutes(-80)), enabled: false),
+            AutomaticDosingChange(date: now.addingTimeInterval(.minutes(-45)), enabled: true)
+        ]
+        charts.setLoopStatusPeriods(LoopStatusTimeline.periods(
+            successfulLoopDates: loopDates,
+            automaticDosingChanges: changes,
+            currentAutomaticDosingEnabled: true,
+            start: start,
+            now: now
+        ))
+    }
+}
+#endif
