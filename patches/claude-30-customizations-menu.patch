+// MARK: - Customizations
+
+/// Optional features, each turned on or off in Settings → Customizations. Every one is off
+/// unless turned on, so a fresh build works like regular Loop.
+enum Customization: String, CaseIterable, Identifiable {
+    case loopStatusBackground
+    case combinedInsulinChart
+    case chartHistoryAndGestures
+    case forecastCloud
+    case glucoseCeiling
+    case bolusMarks
+    case mealBreakdown
+    case lowReservoirRepeat
+    case originalToolbarSize
+
+    /// What a switch is set to before anyone touches it. A personal build can change this one line
+    /// to start with everything on.
+    static let defaultIsOn = false
+
+    /// Posted on the main queue whenever a switch changes.
+    static let didChangeNotification = Notification.Name("com.loopkit.Loop.CustomizationDidChange")
+
+    var id: String { rawValue }
+
+    private var defaultsKey: String { "com.loopkit.Loop.Customization." + rawValue }
+
+    var isOn: Bool {
+        get {
+            return UserDefaults.standard.object(forKey: defaultsKey) as? Bool ?? Self.defaultIsOn
+        }
+        nonmutating set {
+            UserDefaults.standard.set(newValue, forKey: defaultsKey)
+            NotificationCenter.default.post(name: Self.didChangeNotification, object: nil)
+        }
+    }
+
+    /// A snapshot of every switch, to tell whether anything changed.
+    static var current: [Customization: Bool] {
+        return Dictionary(uniqueKeysWithValues: allCases.map { ($0, $0.isOn) })
+    }
+
+    enum Group: CaseIterable {
+        case charts
+        case meals
+        case alerts
+        case layout
+
+        var title: String {
+            switch self {
+            case .charts: return NSLocalizedString("Charts", comment: "Customizations group: charts")
+            case .meals: return NSLocalizedString("Meals", comment: "Customizations group: meals")
+            case .alerts: return NSLocalizedString("Alerts", comment: "Customizations group: alerts")
+            case .layout: return NSLocalizedString("Layout", comment: "Customizations group: layout")
+            }
+        }
+
+        var members: [Customization] {
+            return Customization.allCases.filter { $0.group == self }
+        }
+    }
+
+    var group: Group {
+        switch self {
+        case .loopStatusBackground, .combinedInsulinChart, .chartHistoryAndGestures, .forecastCloud, .glucoseCeiling, .bolusMarks:
+            return .charts
+        case .mealBreakdown:
+            return .meals
+        case .lowReservoirRepeat:
+            return .alerts
+        case .originalToolbarSize:
+            return .layout
+        }
+    }
+
+    var systemImage: String {
+        switch self {
+        case .loopStatusBackground: return "square.stack.3d.down.right"
+        case .combinedInsulinChart: return "drop"
+        case .chartHistoryAndGestures: return "hand.draw"
+        case .forecastCloud: return "scribble.variable"
+        case .glucoseCeiling: return "arrow.up.to.line"
+        case .bolusMarks: return "syringe"
+        case .mealBreakdown: return "fork.knife"
+        case .lowReservoirRepeat: return "bell.badge"
+        case .originalToolbarSize: return "rectangle.bottomthird.inset.filled"
+        }
+    }
+
+    var title: String {
+        switch self {
+        case .loopStatusBackground: return NSLocalizedString("Loop Status Background", comment: "Customization title")
+        case .combinedInsulinChart: return NSLocalizedString("Combined Insulin Chart", comment: "Customization title")
+        case .chartHistoryAndGestures: return NSLocalizedString("7-Day History and Gestures", comment: "Customization title")
+        case .forecastCloud: return NSLocalizedString("Past Predictions", comment: "Customization title")
+        case .glucoseCeiling: return NSLocalizedString("Glucose Chart Capped at 300", comment: "Customization title")
+        case .bolusMarks: return NSLocalizedString("Bolus Marks", comment: "Customization title")
+        case .mealBreakdown: return NSLocalizedString("Meal Breakdown", comment: "Customization title")
+        case .lowReservoirRepeat: return NSLocalizedString("Low Reservoir Repeat", comment: "Customization title")
+        case .originalToolbarSize: return NSLocalizedString("Original Bottom Bar Size", comment: "Customization title")
+        }
+    }
+
+    /// One line for the list.
+    var summary: String {
+        switch self {
+        case .loopStatusBackground: return NSLocalizedString("Chart background shows when Loop was running", comment: "Customization summary")
+        case .combinedInsulinChart: return NSLocalizedString("Active insulin drawn inside the delivery chart", comment: "Customization summary")
+        case .chartHistoryAndGestures: return NSLocalizedString("Swipe back through 7 days, pinch to zoom", comment: "Customization summary")
+        case .forecastCloud: return NSLocalizedString("Faint lines of earlier predictions", comment: "Customization summary")
+        case .glucoseCeiling: return NSLocalizedString("Keeps the glucose scale from stretching", comment: "Customization summary")
+        case .bolusMarks: return NSLocalizedString("Failed boluses, shots, and pump boluses", comment: "Customization summary")
+        case .mealBreakdown: return NSLocalizedString("Split a meal into timed carb entries", comment: "Customization summary")
+        case .lowReservoirRepeat: return NSLocalizedString("Choose how often the alert repeats", comment: "Customization summary")
+        case .originalToolbarSize: return NSLocalizedString("Wider buttons on iOS 27", comment: "Customization summary")
+        }
+    }
+
+    /// The explanation on the feature's own page.
+    var details: [String] {
+        switch self {
+        case .loopStatusBackground:
+            return [
+                NSLocalizedString("Shades the background of the main screen charts to match the loop circle: green while Loop is running, yellow 6 to 16 minutes after the last successful cycle, red after 16 minutes, and gray while automatic dosing is off.", comment: "Customization details"),
+                NSLocalizedString("Built from Loop's own saved cycle records. The app also keeps a small 7-day copy so the history survives a restart. Display only.", comment: "Customization details"),
+            ]
+        case .combinedInsulinChart:
+            return [
+                NSLocalizedString("Replaces the separate Active Insulin chart. Active insulin is drawn as a light shaded area behind the insulin delivery bars, on the same scale, so 2 units active sits at the same height as a 2 unit bolus.", comment: "Customization details"),
+                NSLocalizedString("The chart's subtitle shows active insulin and today's total. Press and hold shows the active insulin at that time. Display only.", comment: "Customization details"),
+            ]
+        case .chartHistoryAndGestures:
+            return [
+                NSLocalizedString("Swipe sideways on the charts to go back up to 7 days, with a glide when you flick. Pinch to show 1 to 24 hours. Press and hold to read values. Double-tap a chart to open its detail screen; a single tap does nothing, so dragging never opens a screen by accident.", comment: "Customization details"),
+                NSLocalizedString("While scrolled back, a \"Back to now\" button appears below the charts, the current forecast stays on screen, and the glucose scale is fixed from the last 7 days so it doesn't jump. Reopening the app always returns to now. Display only.", comment: "Customization details"),
+            ]
+        case .forecastCloud:
+            return [
+                NSLocalizedString("Draws every prediction Loop made in the past as a faint line, 4 hours ahead each, so you can see how the forecast changed over time.", comment: "Customization details"),
+                NSLocalizedString("Press and hold the glucose chart to see just the prediction Loop made at that moment. The faint lines can be hidden with \"Show Past Predictions\" on the glucose detail screen. Display only.", comment: "Customization details"),
+            ]
+        case .glucoseCeiling:
+            return [
+                NSLocalizedString("The main glucose chart tops out at 300 mg/dL, so one high reading doesn't squash the rest of the chart. Higher readings sit on the top edge; press and hold shows the real number. Display only.", comment: "Customization details"),
+            ]
+        case .bolusMarks:
+            return [
+                NSLocalizedString("Marks on the insulin chart: a red × where a bolus came back with an error, and a red ? when the pump couldn't confirm delivery. A ? disappears when the bolus shows up in the pump history, or turns into an × once the pump knows it wasn't delivered.", comment: "Customization details"),
+                NSLocalizedString("Bolus icons: a solid triangle for boluses Loop sent, a hollow triangle for boluses entered on the pump's own buttons (pumps that report it, such as Medtronic), and a syringe for shots logged with Log Dose. Display only.", comment: "Customization details"),
+            ]
+        case .mealBreakdown:
+            return [
+                NSLocalizedString("Adds a Meal Breakdown tab to the carb entry screen. Enter a meal's time, carbs, sugars, fiber, protein, and fat, and it is split into up to three timed carb entries: 🍭 sugars now, 🌮 most starches now over 3 hours, and 🍕 the rest plus some protein, starting later.", comment: "Customization details"),
+                NSLocalizedString("Unlike the chart features, this creates real carb entries, which Loop uses for dosing. Loop's own bolus screen then opens with its own recommendation. The formula can be changed below, and every Meal Breakdown is kept in Meal History.", comment: "Customization details"),
+            ]
+        case .lowReservoirRepeat:
+            return [
+                NSLocalizedString("Lets you choose how often the low reservoir notification on the phone repeats, from 5 minutes to 8 hours. The first alert always comes through. \"Reservoir empty\" and every other alert are not affected, and the pump's own beeps are unchanged.", comment: "Customization details"),
+            ]
+        case .originalToolbarSize:
+            return [
+                NSLocalizedString("On iOS 27, Loop removes the spacing around the buttons in the bottom bar (carbs, pre-meal, bolus, workout, and settings), which makes the bar narrower. This keeps the spacing, so the bar stays its earlier size. No effect before iOS 27.", comment: "Customization details"),
+            ]
+        }
+    }
+}
