+// MARK: - Customizations
+
+/// Settings → Customizations: optional features, grouped, each with its own page and switch.
+struct CustomizationsView: View {
+    /// Re-read when a switch changes, so the On/Off labels stay current.
+    @State private var states = Customization.current
+
+    var body: some View {
+        List {
+            Section {
+                Text("Everything here starts off, so the app works like regular Loop. Turn features on one at a time. Most change only what is shown; Meal Breakdown and Low Reservoir Repeat say on their pages what else they do.", comment: "Customizations: intro")
+                    .font(.footnote)
+                    .foregroundColor(.secondary)
+                    .fixedSize(horizontal: false, vertical: true)
+            }
+            ForEach(Customization.Group.allCases, id: \.self) { group in
+                Section(header: Text(group.title)) {
+                    ForEach(group.members) { customization in
+                        NavigationLink(destination: CustomizationDetailView(customization: customization)) {
+                            HStack(spacing: 12) {
+                                Image(systemName: customization.systemImage)
+                                    .foregroundColor(.accentColor)
+                                    .frame(width: 28)
+                                VStack(alignment: .leading, spacing: 2) {
+                                    Text(customization.title)
+                                    Text(customization.summary)
+                                        .font(.footnote)
+                                        .foregroundColor(.secondary)
+                                }
+                                Spacer()
+                                Text(states[customization] == true
+                                     ? NSLocalizedString("On", comment: "Customizations: switch is on")
+                                     : NSLocalizedString("Off", comment: "Customizations: switch is off"))
+                                    .foregroundColor(.secondary)
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        .insetGroupedListStyle()
+        .navigationTitle(NSLocalizedString("Customizations", comment: "Customizations screen title"))
+        .onAppear {
+            states = Customization.current
+        }
+        .onReceive(NotificationCenter.default.publisher(for: Customization.didChangeNotification)) { _ in
+            states = Customization.current
+        }
+    }
+}
+
+/// One customization: what it does, and its switch.
+struct CustomizationDetailView: View {
+    let customization: Customization
+    @State private var isOn: Bool
+    @State private var lowReservoirInterval: TimeInterval = LowReservoirAlertThrottle.repeatInterval
+
+    init(customization: Customization) {
+        self.customization = customization
+        _isOn = State(initialValue: customization.isOn)
+    }
+
+    var body: some View {
+        List {
+            Section {
+                Toggle(isOn: $isOn) {
+                    Label(customization.title, systemImage: customization.systemImage)
+                }
+            }
+            Section(header: Text("What it does", comment: "Customization page: explanation header")) {
+                ForEach(customization.details, id: \.self) { paragraph in
+                    Text(paragraph)
+                        .fixedSize(horizontal: false, vertical: true)
+                        .padding(.vertical, 2)
+                }
+            }
+            if isOn {
+                extraSettings
+            }
+        }
+        .insetGroupedListStyle()
+        .navigationTitle(customization.title)
+        .onChange(of: isOn) { _, newValue in
+            customization.isOn = newValue
+        }
+        .onChange(of: lowReservoirInterval) { _, newValue in
+            LowReservoirAlertThrottle.repeatInterval = newValue
+        }
+    }
+
+    @ViewBuilder
+    private var extraSettings: some View {
+        switch customization {
+        case .mealBreakdown:
+            Section {
+                NavigationLink(destination: MealBreakdownSettingsView()) {
+                    Label(NSLocalizedString("Meal Formula and History", comment: "Customization page: link to the Meal Breakdown formula and history"), systemImage: "function")
+                }
+            }
+        case .lowReservoirRepeat:
+            Section(footer: Text("Also in Settings → Alert Management.", comment: "Low reservoir customization: where else the setting is")) {
+                Picker(NSLocalizedString("Repeat every", comment: "Low Reservoir Alerts: picker title"), selection: $lowReservoirInterval) {
+                    ForEach(LowReservoirAlertThrottle.intervalChoices, id: \.self) { choice in
+                        Text(LowReservoirAlertThrottle.intervalText(choice)).tag(choice)
+                    }
+                }
+                .pickerStyle(.menu)
+            }
+        default:
+            EmptyView()
+        }
+    }
+}
