diff --git a/LoopKit/LoopKitUI/Charts/ChartHistoryScrubberView.swift b/LoopKit/LoopKitUI/Charts/ChartHistoryScrubberView.swift
new file mode 100644
index 0000000..1f8aaa4
--- /dev/null
+++ b/LoopKit/LoopKitUI/Charts/ChartHistoryScrubberView.swift
@@ -0,0 +1,197 @@
+//
+//  ChartHistoryScrubberView.swift
+//  LoopKitUI
+//
+//  Display only. A slider under the main-screen charts that moves all of them
+//  back in time together, with a button to return to now.
+//
+
+import Foundation
+import LoopKit
+import UIKit
+
+public final class ChartHistoryScrubberView: UIView {
+
+    public static let preferredHeight: CGFloat = 92
+
+    /// Called with the new offset (how far back the charts should look) when the
+    /// slider is released or "Back to now" is tapped.
+    public var onChange: ((TimeInterval) -> Void)?
+
+    /// The furthest back the slider can go.
+    public var maximumOffset: TimeInterval = .hours(24 * 7) {
+        didSet {
+            if offset > maximumOffset {
+                setOffset(maximumOffset)
+            } else {
+                updateSlider()
+            }
+            updateHints()
+        }
+    }
+
+    /// How far back the charts currently look. Zero means now.
+    public private(set) var offset: TimeInterval = 0
+
+    private let slider = UISlider()
+    private let titleLabel = UILabel()
+    private let nowButton = UIButton(type: .system)
+    private let oldestHint = UILabel()
+    private let newestHint = UILabel()
+
+    private static let step: TimeInterval = .minutes(15)
+
+    private lazy var agoFormatter: DateComponentsFormatter = {
+        let formatter = DateComponentsFormatter()
+        formatter.unitsStyle = .full
+        formatter.allowedUnits = [.day, .hour, .minute]
+        formatter.maximumUnitCount = 2
+        return formatter
+    }()
+
+    private lazy var windowFormatter: DateIntervalFormatter = {
+        let formatter = DateIntervalFormatter()
+        formatter.dateTemplate = "EEEMMMdjmm"
+        return formatter
+    }()
+
+    public override init(frame: CGRect) {
+        super.init(frame: frame)
+        setUp()
+    }
+
+    public required init?(coder: NSCoder) {
+        super.init(coder: coder)
+        setUp()
+    }
+
+    private func setUp() {
+        backgroundColor = .clear
+
+        titleLabel.font = .preferredFont(forTextStyle: .footnote)
+        titleLabel.textColor = .secondaryLabel
+        titleLabel.adjustsFontSizeToFitWidth = true
+        titleLabel.minimumScaleFactor = 0.8
+        titleLabel.setContentHuggingPriority(.defaultLow, for: .horizontal)
+        titleLabel.setContentCompressionResistancePriority(.defaultLow, for: .horizontal)
+
+        nowButton.setTitle(LocalizedString("Back to now", comment: "Button that returns the main-screen charts to the current time"), for: .normal)
+        nowButton.titleLabel?.font = .preferredFont(forTextStyle: .footnote)
+        nowButton.setContentHuggingPriority(.required, for: .horizontal)
+        nowButton.setContentCompressionResistancePriority(.required, for: .horizontal)
+        nowButton.addTarget(self, action: #selector(returnToNow), for: .touchUpInside)
+
+        // Left end is the oldest history, right end is now.
+        slider.minimumValue = 0
+        slider.maximumValue = 1
+        slider.value = 1
+        slider.addTarget(self, action: #selector(sliderMoved), for: .valueChanged)
+        slider.addTarget(self, action: #selector(sliderReleased), for: [.touchUpInside, .touchUpOutside, .touchCancel])
+        slider.accessibilityLabel = LocalizedString("Chart history", comment: "Accessibility label for the chart history slider")
+
+        for hint in [oldestHint, newestHint] {
+            hint.font = .preferredFont(forTextStyle: .caption2)
+            hint.textColor = .tertiaryLabel
+        }
+        newestHint.text = LocalizedString("Now", comment: "Right end of the chart history slider")
+        newestHint.textAlignment = .right
+
+        let topRow = UIStackView(arrangedSubviews: [titleLabel, nowButton])
+        topRow.axis = .horizontal
+        topRow.spacing = 8
+        topRow.alignment = .center
+
+        let hintsRow = UIStackView(arrangedSubviews: [oldestHint, newestHint])
+        hintsRow.axis = .horizontal
+        hintsRow.distribution = .fillEqually
+
+        let stack = UIStackView(arrangedSubviews: [topRow, slider, hintsRow])
+        stack.axis = .vertical
+        stack.spacing = 2
+        stack.translatesAutoresizingMaskIntoConstraints = false
+        addSubview(stack)
+
+        NSLayoutConstraint.activate([
+            stack.leadingAnchor.constraint(equalTo: leadingAnchor, constant: 16),
+            stack.trailingAnchor.constraint(equalTo: trailingAnchor, constant: -16),
+            stack.topAnchor.constraint(equalTo: topAnchor, constant: 6),
+            stack.bottomAnchor.constraint(lessThanOrEqualTo: bottomAnchor, constant: -6)
+        ])
+
+        updateHints()
+        updateTitle(window: nil)
+    }
+
+    /// Moves the slider. Calls `onChange` only when `notify` is true.
+    public func setOffset(_ newOffset: TimeInterval, notify: Bool = false) {
+        offset = Self.rounded(min(max(0, newOffset), maximumOffset))
+        updateSlider()
+        nowButton.isEnabled = offset > 0
+        if notify {
+            onChange?(offset)
+        }
+    }
+
+    /// Shows the time range the charts are displaying.
+    public func setWindow(start: Date, end: Date) {
+        updateTitle(window: DateInterval(start: start, end: max(start, end)))
+    }
+
+    private func updateSlider() {
+        guard maximumOffset > 0 else {
+            slider.value = 1
+            return
+        }
+        slider.value = Float(1 - offset / maximumOffset)
+    }
+
+    private func updateHints() {
+        oldestHint.text = String(
+            format: LocalizedString("%@ ago", comment: "Left end of the chart history slider. (1: how long ago)"),
+            agoFormatter.string(from: maximumOffset) ?? ""
+        )
+    }
+
+    private func updateTitle(window: DateInterval?) {
+        if offset == 0 {
+            titleLabel.text = LocalizedString("Showing now. Drag to look back.", comment: "Chart history slider title when showing the current time")
+        } else if let window = window {
+            titleLabel.text = windowFormatter.string(from: window.start, to: window.end)
+        } else {
+            titleLabel.text = agoDescription(offset)
+        }
+        nowButton.isEnabled = offset > 0
+    }
+
+    private func agoDescription(_ offset: TimeInterval) -> String {
+        guard offset > 0 else {
+            return LocalizedString("Now", comment: "Right end of the chart history slider")
+        }
+        return String(
+            format: LocalizedString("%@ ago", comment: "Left end of the chart history slider. (1: how long ago)"),
+            agoFormatter.string(from: offset) ?? ""
+        )
+    }
+
+    private func offsetForSlider() -> TimeInterval {
+        return Self.rounded(TimeInterval(1 - slider.value) * maximumOffset)
+    }
+
+    private static func rounded(_ offset: TimeInterval) -> TimeInterval {
+        return (offset / step).rounded() * step
+    }
+
+    @objc private func sliderMoved() {
+        titleLabel.text = agoDescription(offsetForSlider())
+    }
+
+    @objc private func sliderReleased() {
+        setOffset(offsetForSlider(), notify: true)
+        updateTitle(window: nil)
+    }
+
+    @objc private func returnToNow() {
+        setOffset(0, notify: true)
+        updateTitle(window: nil)
+    }
+}
