+/// Small labels on the right edge showing the active insulin scale (for example "2 U").
+final class ActiveInsulinScaleLabelsLayer: ChartCoordsSpaceLayer {
+    private let values: [Double]
+    private let font: UIFont
+    private let color: UIColor
+
+    init?(xAxis: ChartAxis, yAxis: ChartAxis, values: [Double], font: UIFont, color: UIColor) {
+        guard !values.isEmpty else {
+            return nil
+        }
+        self.values = values
+        self.font = font.withSize(max(9, font.pointSize - 3))
+        self.color = color
+        super.init(xAxis: xAxis, yAxis: yAxis)
+    }
+
+    override func chartInitialized(chart: Chart) {
+        super.chartInitialized(chart: chart)
+
+        let formatter = NumberFormatter.dose
+        let container = chart.containerView
+        for value in values {
+            let label = UILabel()
+            label.font = font
+            label.textColor = color
+            label.text = (formatter.string(from: NSNumber(value: value)) ?? String(value)) + " U"
+            label.sizeToFit()
+            let y = modelLocToContainerScreenLoc(y: value)
+            label.frame.origin = CGPoint(
+                x: container.bounds.maxX - label.frame.width - 2,
+                y: min(max(0, y - label.frame.height / 2), container.bounds.maxY - label.frame.height)
+            )
+            label.isUserInteractionEnabled = false
+            container.addSubview(label)
+        }
+    }
+}
