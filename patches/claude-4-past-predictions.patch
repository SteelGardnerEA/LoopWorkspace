+        // Made-up past predictions: at each cycle, follow the current trend and level off
+        // over about 45 minutes, so the lines fan out around what really happened.
+        let glucosePeriod = TimeInterval.hours(4)
+        func glucoseAt(_ date: Date) -> Double {
+            130 + 45 * wave(date, period: glucosePeriod)
+        }
+        func slopePerMinuteAt(_ date: Date) -> Double {
+            let angle = date.timeIntervalSince1970 / glucosePeriod * 2 * .pi
+            return 45 * cos(angle) * 2 * .pi / glucosePeriod.minutes
+        }
+        let predictionDates = loopDates.filter { $0 >= start.addingTimeInterval(.hours(-6)) && $0 <= dataEnd }
+        let pastPredictions: [[GlucoseValue]] = predictionDates.map { madeAt -> [GlucoseValue] in
+            let level = glucoseAt(madeAt)
+            let slope = slopePerMinuteAt(madeAt)
+            return (0...72).map { step -> GlucoseValue in
+                let minutes = Double(step) * 5
+                let value = level + slope * 45 * (1 - exp(-minutes / 45))
+                return SimpleGlucoseValue(startDate: madeAt.addingTimeInterval(.minutes(minutes)), quantity: HKQuantity(unit: .milligramsPerDeciliter, doubleValue: value))
+            }
+        }
+        charts.setPastPredictions(pastPredictions)
