+/// Draws many faint, thin, solid lines. Where they overlap, the color builds up, showing
+/// where glucose was expected to go. Clipped to the chart's plot area.
+final class PastPredictionsLayer: ChartCoordsSpaceLayer {
+    /// Each line is a list of (time scalar, glucose value) points.
+    private let lines: [[CGPoint]]
+    private let color: UIColor
+
+    static let lineAlpha: CGFloat = 0.07
+    static let lineWidth: CGFloat = 1
+
+    init?(xAxis: ChartAxis, yAxis: ChartAxis, lines: [[CGPoint]], color: UIColor) {
+        let drawable = lines.filter { $0.count > 1 }
+        guard !drawable.isEmpty else {
+            return nil
+        }
+        self.lines = drawable
+        self.color = color
+        super.init(xAxis: xAxis, yAxis: yAxis)
+    }
+
+    override func chartInitialized(chart: Chart) {
+        super.chartInitialized(chart: chart)
+
+        let axisStart = min(xAxis.first, xAxis.last)
+        let axisEnd = max(xAxis.first, xAxis.last)
+
+        let paths: [CGPath] = lines.compactMap { line in
+            guard let first = line.first, let last = line.last, last.x >= axisStart, first.x <= axisEnd else {
+                return nil
+            }
+            let path = CGMutablePath()
+            for (index, point) in line.enumerated() {
+                let screenPoint = CGPoint(
+                    x: modelLocToContainerScreenLoc(x: Double(point.x)),
+                    y: modelLocToContainerScreenLoc(y: Double(point.y))
+                )
+                if index == 0 {
+                    path.move(to: screenPoint)
+                } else {
+                    path.addLine(to: screenPoint)
+                }
+            }
+            return path
+        }
+
+        guard !paths.isEmpty else {
+            return
+        }
+
+        let view = PastPredictionsView(frame: chart.containerView.bounds, paths: paths, color: color)
+        chart.containerView.insertSubview(view, at: 0)
+    }
+}
+
+final class PastPredictionsView: UIView {
+    private let paths: [CGPath]
+    private let color: UIColor
+
+    init(frame: CGRect, paths: [CGPath], color: UIColor) {
+        self.paths = paths
+        self.color = color
+        super.init(frame: frame)
+        backgroundColor = .clear
+        isUserInteractionEnabled = false
+        clipsToBounds = true
+    }
+
+    required init?(coder aDecoder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override func draw(_ rect: CGRect) {
+        guard let context = UIGraphicsGetCurrentContext() else {
+            return
+        }
+        context.clip(to: bounds)
+        context.setLineWidth(PastPredictionsLayer.lineWidth)
+        context.setLineJoin(.round)
+        context.setStrokeColor(color.withAlphaComponent(PastPredictionsLayer.lineAlpha).cgColor)
+        // One stroke per line, so overlapping lines add up into a darker band.
+        for path in paths {
+            context.addPath(path)
+            context.strokePath()
+        }
+    }
+}
