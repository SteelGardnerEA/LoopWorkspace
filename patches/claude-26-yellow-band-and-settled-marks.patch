@@ -461,4 +461,28 @@ final class FailedBolusLog {
     func marks() -> [FailedBolusMark] {
         return queue.sync { stored }
     }
+
+    /// The marks to draw. An uncertain one (?) is settled once Loop knows: if a bolus shows up
+    /// in the pump history right around then, it went through and the mark is dropped; once the
+    /// pump no longer reports uncertain delivery and no bolus showed up, it becomes an ×.
+    func resolvedMarks(doseEntries: [DoseEntry], deliveryIsUncertain: Bool) -> [FailedBolusMark] {
+        let deliveredBolusDates = doseEntries
+            .filter { $0.type == .bolus && ($0.deliveredUnits ?? $0.programmedUnits) > 0 }
+            .map { $0.startDate }
+        return marks().compactMap { mark in
+            guard mark.uncertain else {
+                return mark
+            }
+            let delivered = deliveredBolusDates.contains { date in
+                date >= mark.date.addingTimeInterval(.minutes(-2)) && date <= mark.date.addingTimeInterval(.minutes(10))
+            }
+            if delivered {
+                return nil
+            }
+            if deliveryIsUncertain {
+                return mark
+            }
+            return FailedBolusMark(date: mark.date, units: mark.units, uncertain: false)
+        }
+    }
 }
