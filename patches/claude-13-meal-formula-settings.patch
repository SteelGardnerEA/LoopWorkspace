+// MARK: - Meal Breakdown formula (shared by the carb screen and Settings)
+
+/// Steppers for the four adjustable numbers in the meal formula.
+struct MealBreakdownFormulaRows: View {
+    @Binding var formula: MealBreakdownFormula
+
+    var body: some View {
+        VStack(spacing: 10) {
+            Stepper(value: $formula.mediumStarchPercent, in: 0...100, step: 5) {
+                row(
+                    title: NSLocalizedString("🌮 Starches in medium", comment: "Meal formula: percent of starches in the medium entry"),
+                    detail: String(format: NSLocalizedString("🍕 delayed gets %@", comment: "Meal formula: the rest of the starches go to the delayed entry (1: percent)"), percent(formula.delayedStarchPercent)),
+                    value: percent(formula.mediumStarchPercent)
+                )
+            }
+            CardSectionDivider()
+            Stepper(value: $formula.proteinPercent, in: 0...100, step: 5) {
+                row(
+                    title: NSLocalizedString("🍕 Protein added", comment: "Meal formula: percent of protein grams added to the delayed entry"),
+                    detail: NSLocalizedString("Of protein grams, as carbs", comment: "Meal formula: protein percent explanation"),
+                    value: percent(formula.proteinPercent)
+                )
+            }
+            CardSectionDivider()
+            Stepper(value: $formula.proteinMinutesPerGram, in: 0...30, step: 0.5) {
+                row(
+                    title: NSLocalizedString("Protein delay", comment: "Meal formula: minutes of delay per gram of protein"),
+                    detail: NSLocalizedString("Minutes per gram", comment: "Meal formula: delay unit explanation"),
+                    value: minutes(formula.proteinMinutesPerGram)
+                )
+            }
+            CardSectionDivider()
+            Stepper(value: $formula.fatMinutesPerGram, in: 0...30, step: 0.5) {
+                row(
+                    title: NSLocalizedString("Fat delay", comment: "Meal formula: minutes of delay per gram of fat"),
+                    detail: NSLocalizedString("Minutes per gram", comment: "Meal formula: delay unit explanation"),
+                    value: minutes(formula.fatMinutesPerGram)
+                )
+            }
+        }
+    }
+
+    private func row(title: String, detail: String, value: String) -> some View {
+        HStack {
+            VStack(alignment: .leading, spacing: 2) {
+                Text(title)
+                Text(detail)
+                    .font(.caption)
+                    .foregroundColor(.secondary)
+            }
+            Spacer()
+            Text(value)
+                .bold()
+                .monospacedDigit()
+        }
+    }
+
+    private func percent(_ value: Double) -> String {
+        return NumberFormatter.localizedString(from: NSNumber(value: value.rounded()), number: .none) + "%"
+    }
+
+    private func minutes(_ value: Double) -> String {
+        let formatter = NumberFormatter()
+        formatter.minimumFractionDigits = 0
+        formatter.maximumFractionDigits = 1
+        let number = formatter.string(from: NSNumber(value: value)) ?? "\(value)"
+        return String(format: NSLocalizedString("%@ min", comment: "Meal formula: minutes value (1: number)"), number)
+    }
+}
+
+/// Settings → Meal Breakdown: the default formula used for each new meal.
+struct MealBreakdownSettingsView: View {
+    @State private var formula: MealBreakdownFormula = .saved
+
+    var body: some View {
+        List {
+            Section(footer: Text("Each Meal Breakdown starts from these numbers. You can change them for a single meal on the carb entry screen.\n\nStarches = carbs − sugars − fiber. 🍭 sugars now; 🌮 the medium share of starches now, over 3 h; 🍕 the rest of the starches plus the protein share, starting 3 h after the meal and running until the protein and fat delay ends. These are ordinary carb entries; Loop's dosing math is unchanged.", comment: "Meal Breakdown settings footer")) {
+                MealBreakdownFormulaRows(formula: $formula)
+                    .padding(.vertical, 4)
+            }
+            Section {
+                Button(NSLocalizedString("Reset to Defaults (60%, 50%, 4 min, 8 min)", comment: "Meal Breakdown settings: reset button")) {
+                    formula = .standard
+                }
+                .disabled(formula == .standard)
+            }
+        }
+        .insetGroupedListStyle()
+        .navigationTitle(NSLocalizedString("Meal Breakdown", comment: "Meal Breakdown settings title"))
+        .onChange(of: formula) { _, newValue in
+            MealBreakdownFormula.saved = newValue
+        }
+    }
+}
