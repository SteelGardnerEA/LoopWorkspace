 /// - Delayed 🍕: 40% of starches + 50% of protein, absorbed from 3 hours after the meal
 ///   until the delay, where delay = (protein × 4 min + fat × 8 min).
 ///   If the delay is 3 hours or less there is no later window, so this part joins 🌮.
+/// The adjustable numbers in Steel's meal formula. The saved copy (Settings → Meal Breakdown) is
+/// the default for each meal; the Meal Breakdown tab can change them for one meal.
+struct MealBreakdownFormula: Codable, Equatable {
+    /// Percent of starches in the 🌮 medium entry; the 🍕 delayed entry gets the rest.
+    var mediumStarchPercent: Double = 60
+    /// Percent of protein grams added to the 🍕 delayed entry.
+    var proteinPercent: Double = 50
+    /// Minutes of delay per gram of protein.
+    var proteinMinutesPerGram: Double = 4
+    /// Minutes of delay per gram of fat.
+    var fatMinutesPerGram: Double = 8
+
+    static let standard = MealBreakdownFormula()
+
+    var delayedStarchPercent: Double {
+        return 100 - mediumStarchPercent
+    }
+
+    private static let defaultsKey = "com.loopkit.Loop.MealBreakdownFormula"
+
+    /// The saved default, or the standard formula if none was saved.
+    static var saved: MealBreakdownFormula {
+        get {
+            guard let data = UserDefaults.standard.data(forKey: defaultsKey),
+                  let formula = try? JSONDecoder().decode(MealBreakdownFormula.self, from: data) else {
+                return .standard
+            }
+            return formula.clamped
+        }
+        set {
+            if let data = try? JSONEncoder().encode(newValue.clamped) {
+                UserDefaults.standard.set(data, forKey: defaultsKey)
+            }
+        }
+    }
+
+    /// Keeps every value in a sensible range.
+    var clamped: MealBreakdownFormula {
+        var formula = self
+        formula.mediumStarchPercent = min(max(mediumStarchPercent, 0), 100)
+        formula.proteinPercent = min(max(proteinPercent, 0), 100)
+        formula.proteinMinutesPerGram = min(max(proteinMinutesPerGram, 0), 30)
+        formula.fatMinutesPerGram = min(max(fatMinutesPerGram, 0), 30)
+        return formula
+    }
+}
