+/// Settings → Low Reservoir Alerts: how often the low reservoir notification may repeat.
+struct LowReservoirAlertSettingsView: View {
+    @State private var interval: TimeInterval = LowReservoirAlertThrottle.repeatInterval
+
+    var body: some View {
+        List {
+            Section(footer: Text("The first low reservoir alert always comes through. After that it repeats at most this often. \"Reservoir empty\" and every other alert are not affected, and the pump's own beeps are unchanged.", comment: "Low Reservoir Alerts settings footer")) {
+                Picker(NSLocalizedString("Repeat at most every", comment: "Low Reservoir Alerts: picker title"), selection: $interval) {
+                    ForEach(LowReservoirAlertThrottle.intervalChoices, id: \.self) { choice in
+                        Text(LowReservoirAlertThrottle.intervalText(choice)).tag(choice)
+                    }
+                }
+                .pickerStyle(.inline)
+            }
+        }
+        .insetGroupedListStyle()
+        .navigationTitle(NSLocalizedString("Low Reservoir Alerts", comment: "Low Reservoir Alerts settings title"))
+        .onChange(of: interval) { _, newValue in
+            LowReservoirAlertThrottle.repeatInterval = newValue
+        }
+    }
+}
