+/// Low reservoir alerts from any pump (Omnipod, Medtronic, Medtrum) are passed on the first time,
+/// then at most once per `repeatInterval` (Settings → Low Reservoir Alerts). Other alerts, including
+/// "reservoir empty", are never held back. Only the phone notification is affected; the pump's own
+/// beeps and Loop's dosing are unchanged.
+enum LowReservoirAlertThrottle {
+    private static let intervalKey = "com.loopkit.Loop.LowReservoirAlertRepeatInterval"
+    private static let lastIssuedKey = "com.loopkit.Loop.LowReservoirAlertLastIssued"
+
+    static let defaultInterval: TimeInterval = .hours(1)
+    static let intervalChoices: [TimeInterval] = [.minutes(5), .minutes(30), .hours(1), .hours(2), .hours(4), .hours(8)]
+
+    static var repeatInterval: TimeInterval {
+        get {
+            let stored = UserDefaults.standard.double(forKey: intervalKey)
+            return stored > 0 ? stored : defaultInterval
+        }
+        set {
+            UserDefaults.standard.set(newValue, forKey: intervalKey)
+        }
+    }
+
+    static func isLowReservoir(_ identifier: Alert.Identifier) -> Bool {
+        let name = identifier.alertIdentifier.lowercased()
+        return name.contains("reservoir") && !name.contains("empty")
+    }
+
+    /// True if the same low reservoir alert was passed on less than `repeatInterval` ago.
+    static func shouldSuppress(_ alert: Alert, now: Date = Date()) -> Bool {
+        guard isLowReservoir(alert.identifier), alert.trigger == .immediate else {
+            return false
+        }
+        var lastIssued = (UserDefaults.standard.dictionary(forKey: lastIssuedKey) as? [String: Date]) ?? [:]
+        let key = alert.identifier.value
+        if let previous = lastIssued[key], now.timeIntervalSince(previous) < repeatInterval {
+            return true
+        }
+        lastIssued[key] = now
+        UserDefaults.standard.set(lastIssued, forKey: lastIssuedKey)
+        return false
+    }
+
+    static func intervalText(_ interval: TimeInterval) -> String {
+        let formatter = DateComponentsFormatter()
+        formatter.allowedUnits = [.hour, .minute]
+        formatter.unitsStyle = .full
+        return formatter.string(from: interval) ?? ""
+    }
+}
