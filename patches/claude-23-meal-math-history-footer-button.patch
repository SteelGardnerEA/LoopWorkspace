+/// One number in a Meal Breakdown equation: small label above, value, unit below (Trio's style).
+private struct MealMathTerm: View {
+    let label: String?
+    let value: Double
+    let unit: String
+    var color: Color = .primary
+
+    var body: some View {
+        VStack(spacing: 1) {
+            Text(label ?? " ")
+                .font(.caption2)
+                .foregroundColor(.secondary)
+            Text(Self.format(value))
+                .font(.headline)
+                .monospacedDigit()
+                .foregroundColor(color)
+            Text(unit)
+                .font(.caption2)
+                .foregroundColor(.secondary)
+        }
+        .lineLimit(1)
+        .minimumScaleFactor(0.7)
+    }
+
+    static func format(_ value: Double) -> String {
+        let formatter = NumberFormatter()
+        formatter.minimumFractionDigits = 0
+        formatter.maximumFractionDigits = abs(value - value.rounded()) < 0.05 || abs(value) >= 10 ? 0 : 1
+        return formatter.string(from: NSNumber(value: value)) ?? "\(value)"
+    }
+}
+
+/// An operator between Meal Breakdown terms.
+private struct MealMathOperator: View {
+    let symbol: String
+
+    init(_ symbol: String) {
+        self.symbol = symbol
+    }
+
+    var body: some View {
+        Text(symbol)
+            .font(.headline)
+            .foregroundColor(.secondary)
+    }
+}
