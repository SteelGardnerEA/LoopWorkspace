+
+
+// MARK: - Meal Breakdown history (display only)
+
+/// One saved Meal Breakdown: what was typed in, the formula used, the entries saved, and the bolus.
+struct MealBreakdownRecord: Codable, Identifiable, Equatable {
+    struct Entry: Codable, Equatable {
+        let foodType: String
+        let grams: Double
+        let start: Date
+        let absorptionTime: TimeInterval
+    }
+
+    let id: UUID
+    let savedAt: Date
+    let mealTime: Date
+    let carbs: Double
+    let sugars: Double
+    let fiber: Double
+    let protein: Double
+    let fat: Double
+    let formula: MealBreakdownFormula
+    let entries: [Entry]
+    /// Units delivered from the Meal Bolus screen: 0 = saved without bolusing, nil = left without either.
+    var bolusUnits: Double?
+
+    init(id: UUID, savedAt: Date, mealTime: Date, breakdown: MealBreakdown, entries: [Entry]) {
+        self.id = id
+        self.savedAt = savedAt
+        self.mealTime = mealTime
+        self.carbs = breakdown.carbs
+        self.sugars = breakdown.sugars
+        self.fiber = breakdown.fiber
+        self.protein = breakdown.protein
+        self.fat = breakdown.fat
+        self.formula = breakdown.formula
+        self.entries = entries
+        self.bolusUnits = nil
+    }
+
+    var breakdown: MealBreakdown {
+        return MealBreakdown(carbs: carbs, sugars: sugars, fiber: fiber, protein: protein, fat: fat, formula: formula)
+    }
+
+    var totalGrams: Double {
+        return entries.reduce(0) { $0 + $1.grams }
+    }
+}
+
+/// Saved Meal Breakdowns, newest first, kept for a year in the app's own folder.
+final class MealBreakdownHistory: ObservableObject {
+    static let shared = MealBreakdownHistory()
+
+    @Published private(set) var records: [MealBreakdownRecord] = []
+
+    private let keepDuration: TimeInterval = .days(365)
+    private let maximumCount = 1000
+
+    private var fileURL: URL? {
+        guard let base = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first else {
+            return nil
+        }
+        try? FileManager.default.createDirectory(at: base, withIntermediateDirectories: true)
+        return base.appendingPathComponent("MealBreakdownHistory.json")
+    }
+
+    init() {
+        if let url = fileURL, let data = try? Data(contentsOf: url),
+           let saved = try? JSONDecoder().decode([MealBreakdownRecord].self, from: data) {
+            records = saved
+        }
+    }
+
+    func add(_ record: MealBreakdownRecord) {
+        var updated = [record] + records.filter { $0.id != record.id }
+        let oldest = Date().addingTimeInterval(-keepDuration)
+        updated = Array(updated.filter { $0.savedAt >= oldest }.prefix(maximumCount))
+        save(updated)
+    }
+
+    func setBolus(_ units: Double, for id: UUID) {
+        guard let index = records.firstIndex(where: { $0.id == id }) else {
+            return
+        }
+        var updated = records
+        updated[index].bolusUnits = units
+        save(updated)
+    }
+
+    func delete(_ id: UUID) {
+        save(records.filter { $0.id != id })
+    }
+
+    private func save(_ updated: [MealBreakdownRecord]) {
+        let apply = {
+            self.records = updated
+        }
+        if Thread.isMainThread {
+            apply()
+        } else {
+            DispatchQueue.main.async(execute: apply)
+        }
+        guard let url = fileURL, let data = try? JSONEncoder().encode(updated) else {
+            return
+        }
+        try? data.write(to: url, options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+    }
+}
