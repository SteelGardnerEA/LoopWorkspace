+// MARK: - Meal Breakdown history
+
+/// Every saved Meal Breakdown, newest first: what was entered, the formula, the entries, and the bolus.
+struct MealBreakdownHistoryView: View {
+    @ObservedObject private var history = MealBreakdownHistory.shared
+
+    var body: some View {
+        List {
+            if history.records.isEmpty {
+                Text("No meal breakdowns yet. Each one you save shows up here.", comment: "Meal breakdown history: empty")
+                    .foregroundColor(.secondary)
+            }
+            ForEach(days, id: \.self) { day in
+                Section(header: Text(Self.dayFormatter.string(from: day))) {
+                    ForEach(history.records.filter { Calendar.current.isDate($0.mealTime, inSameDayAs: day) }) { record in
+                        NavigationLink(destination: MealBreakdownRecordView(record: record)) {
+                            MealBreakdownHistoryRow(record: record)
+                        }
+                    }
+                    .onDelete { offsets in
+                        let records = history.records.filter { Calendar.current.isDate($0.mealTime, inSameDayAs: day) }
+                        offsets.map { records[$0].id }.forEach { history.delete($0) }
+                    }
+                }
+            }
+        }
+        .insetGroupedListStyle()
+        .navigationTitle(NSLocalizedString("Meal History", comment: "Meal breakdown history title"))
+    }
+
+    private var days: [Date] {
+        var seen = Set<Date>()
+        return history.records.compactMap { record in
+            let day = Calendar.current.startOfDay(for: record.mealTime)
+            return seen.insert(day).inserted ? day : nil
+        }
+    }
+
+    static let dayFormatter: DateFormatter = {
+        let formatter = DateFormatter()
+        formatter.setLocalizedDateFormatFromTemplate("EEEEMMMd")
+        return formatter
+    }()
+
+    static let timeFormatter: DateFormatter = {
+        let formatter = DateFormatter()
+        formatter.dateStyle = .none
+        formatter.timeStyle = .short
+        return formatter
+    }()
+
+    static func grams(_ value: Double) -> String {
+        return NumberFormatter.localizedString(from: NSNumber(value: value.rounded()), number: .none) + " g"
+    }
+
+    static func bolusText(_ record: MealBreakdownRecord) -> String {
+        guard let units = record.bolusUnits else {
+            return NSLocalizedString("No bolus recorded", comment: "Meal breakdown history: left the bolus screen without either option")
+        }
+        if units <= 0 {
+            return NSLocalizedString("Saved without bolusing", comment: "Meal breakdown history: no bolus")
+        }
+        let formatter = NumberFormatter()
+        formatter.minimumFractionDigits = 0
+        formatter.maximumFractionDigits = 2
+        return String(format: NSLocalizedString("Bolused %@ U", comment: "Meal breakdown history: bolus amount (1: units)"), formatter.string(from: NSNumber(value: units)) ?? "\(units)")
+    }
+}
