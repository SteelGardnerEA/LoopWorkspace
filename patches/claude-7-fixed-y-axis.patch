     }
 }
+
+
+/// Keeps a chart's vertical scale from shrinking while the user browses, so scrolling
+/// doesn't rescale it. While holding, each drawing's range is widened to the widest
+/// range seen since holding began (starting from the range shown at that moment).
+public struct ChartYAxisRangeHolder {
+    public var isHolding = false {
+        didSet {
+            if isHolding != oldValue {
+                held = isHolding ? last : nil
+            }
+        }
+    }
+
+    private var held: ClosedRange<Double>?
+    private var last: ClosedRange<Double>?
+
+    public init() {}
+
+    /// Records this drawing's own range and returns extra points that keep the held range in view.
+    public mutating func extraPoints(for points: [ChartPoint]) -> [ChartPoint] {
+        let scalars = points.map { $0.y.scalar }
+        guard let lowest = scalars.min(), let highest = scalars.max() else {
+            return []
+        }
+        last = lowest...highest
+        guard isHolding else {
+            return []
+        }
+        let range = held.map { min($0.lowerBound, lowest)...max($0.upperBound, highest) } ?? (lowest...highest)
+        held = range
+        return [range.lowerBound, range.upperBound].map {
+            ChartPoint(x: ChartAxisValue(scalar: 0), y: ChartAxisValue(scalar: $0))
+        }
+    }
+}
