+extension StatusChartsManager {
+    /// Display only. Holds the insulin and carb charts' vertical scales steady while browsing.
+    func setHoldsYAxisRanges(_ holds: Bool) {
+        dose.yAxisRangeHolder.isHolding = holds
+        cob.yAxisRangeHolder.isHolding = holds
+    }
+
+    /// Display only. Sets the glucose chart's vertical scale, redrawing only if it changed.
+    func setGlucoseDisplayRange(_ range: ClosedRange<HKQuantity>) {
+        guard range != glucose.glucoseDisplayRange else {
+            return
+        }
+        glucose.glucoseDisplayRange = range
+        invalidateChart(atIndex: ChartIndex.glucose.rawValue)
+    }
+
+    /// Trio-style glucose scale from the last 7 days of readings, so the chart doesn't
+    /// rescale as it scrolls: the top steps through 200, 250, 300, 350, and 400 mg/dL,
+    /// and the bottom sits just below the 7-day low. Never narrower than `defaultRange`.
+    static func glucoseScale(forWeek week: ClosedRange<Double>, defaultRange: ClosedRange<HKQuantity>) -> ClosedRange<HKQuantity> {
+        let defaultLower = defaultRange.lowerBound.doubleValue(for: .milligramsPerDeciliter)
+        let defaultUpper = defaultRange.upperBound.doubleValue(for: .milligramsPerDeciliter)
+
+        let top: Double
+        if week.upperBound <= 200 {
+            top = 200
+        } else if week.upperBound <= 225 {
+            top = 250
+        } else if week.upperBound <= 275 {
+            top = 300
+        } else if week.upperBound <= 325 {
+            top = 350
+        } else {
+            top = 400
+        }
+
+        let bottom = max(39, (min(week.lowerBound, defaultLower, 70) / 10).rounded(.down) * 10)
+        return HKQuantity(unit: .milligramsPerDeciliter, doubleValue: bottom)...HKQuantity(unit: .milligramsPerDeciliter, doubleValue: max(top, defaultUpper))
+    }
+}
